<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pulsar.Agent.Linux\Pulsar.Agent.Linux.csproj" />
    <!-- Built first and copied next to the tests (see below); not referenced as assemblies. -->
    <ProjectReference Include="..\Pulsar.TestGameServer\Pulsar.TestGameServer.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\src\Pulsar.Agent\Pulsar.Agent.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The agent's Linux build (game-exec) and the test game, beside the tests. -->
  <Target Name="CopyTestGameAndAgent" AfterTargets="Build">
    <ItemGroup>
      <TestGameServerFiles Include="..\Pulsar.TestGameServer\bin\$(Configuration)\net10.0\linux-x64\**\*" />
      <AgentFiles Include="..\..\src\Pulsar.Agent\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestGameServerFiles)" DestinationFolder="$(OutDir)testgame\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AgentFiles)" DestinationFolder="$(OutDir)agent\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
