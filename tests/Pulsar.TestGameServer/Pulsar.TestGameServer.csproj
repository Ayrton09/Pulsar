<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows agent's tests run its Windows build, the Linux agent's its Linux one. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Pulsar.TestGameServer</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Its Linux build runs as a server's own user, who cannot read the .NET of the user running the tests: it brings its
    own runtime, as a game would (built so on every system, so that restores do not depend on where they run).
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>
