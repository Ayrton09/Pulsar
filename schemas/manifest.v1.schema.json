{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ayrton09/Pulsar/main/schemas/manifest.v1.schema.json",
  "title": "Pulsar game manifest (schema version 1)",
  "description": "Describes how Pulsar installs, starts, watches and stops a game server. Declarative and closed: there is no shell, script or expression anywhere. Pulsar validates more than this schema can express (placeholders, regular expressions, paths); see docs/architecture/04-game-manifests.md.",
  "$ref": "#/$defs/GameManifest",
  "$defs": {
    "GameManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "key", "version", "name", "platforms", "runtime", "readiness", "stop"],
      "properties": {
        "$schema": { "type": "string", "description": "Editor hint; ignored by Pulsar." },
        "schemaVersion": { "const": 1, "description": "Version of this format." },
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "description": "Identifies the game; with the version, a template that never changes." },
        "version": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$", "description": "Semantic version of this manifest's content." },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows-x64"] } },
        "requirements": { "$ref": "#/$defs/RequirementsDefinition" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/VariableDefinition" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/PortDefinition" } },
        "install": { "$ref": "#/$defs/InstallDefinition", "description": "Steps run when the server is installed or reinstalled." },
        "update": { "$ref": "#/$defs/InstallDefinition", "description": "Steps run when the game is updated. Without them, updates are not offered." },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "windows-x64": { "$ref": "#/$defs/RuntimeDefinition" } }
        },
        "configFiles": { "type": "array", "items": { "$ref": "#/$defs/ConfigFileDefinition" } },
        "readiness": { "$ref": "#/$defs/ReadinessDefinition" },
        "stop": { "$ref": "#/$defs/StopDefinition" },
        "backup": { "$ref": "#/$defs/BackupDefinition" },
        "query": { "$ref": "#/$defs/QueryDefinition" },
        "addons": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/AddonDefinition" }, "description": "Mods the game supports, installed on request." }
      }
    },
    "AddonDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "license", "url", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 512 },
        "license": { "type": "string", "minLength": 1, "maxLength": 64, "description": "As the addon's authors state it; shown before installing." },
        "url": { "type": "string", "pattern": "^https://", "maxLength": 256, "description": "The addon's home page." },
        "source": { "$ref": "#/$defs/GitHubReleaseSource" },
        "target": {
          "oneOf": [{ "const": "" }, { "$ref": "#/$defs/RelativePath" }],
          "description": "Folder of the server the archive is unpacked into (a relative path, with its rules); empty for the server's folder."
        },
        "requires": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "reinstallAfterUpdate": { "type": "boolean", "default": false, "description": "The game's updates overwrite it: its latest release is installed again after each update." },
        "lineEdits": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/LineEdit" } }
      }
    },
    "GitHubReleaseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "asset"],
      "description": "A zip asset of a GitHub release, checked against the SHA-256 GitHub publishes for it. A fixed 'tag' cannot go with 'prerelease': true (that only picks the newest release).",
      "not": { "required": ["tag", "prerelease"], "properties": { "prerelease": { "const": true } } },
      "properties": {
        "type": { "const": "githubRelease" },
        "repo": { "type": "string", "pattern": "^(?!\\.\\.?/)[A-Za-z0-9_.-]{1,100}/(?!\\.\\.?$)[A-Za-z0-9_.-]{1,100}$" },
        "asset": { "type": "string", "maxLength": 200, "description": "Regular expression for the asset's file name." },
        "tag": { "type": "string", "pattern": "^(?!\\.\\.?$)[A-Za-z0-9_.-]{1,64}$", "description": "A fixed release; the latest one without it." },
        "prerelease": { "type": "boolean", "default": false, "description": "Take the newest release even when it is marked as a pre-release." }
      }
    },
    "LineEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "after", "line"],
      "description": "Keeps 'line' right after the first line of 'path' that reads 'after' (spaces aside), before every start.",
      "properties": {
        "path": { "$ref": "#/$defs/RelativePath" },
        "after": { "type": "string", "minLength": 1, "maxLength": 256 },
        "line": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "RequirementsDefinition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shown when a server is created; not enforced.",
      "properties": {
        "minDiskGb": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "minMemoryMb": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "VariableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "enum": ["string", "integer", "boolean", "enum", "number"], "description": "number: a decimal (\"1.5\"), up to 6 decimals." },
        "default": { "type": ["string", "number", "boolean"], "description": "A scalar; its text is checked like a value users enter." },
        "required": { "type": "boolean", "default": false },
        "secret": { "type": "boolean", "default": false, "description": "Encrypted at rest, write-only in the API, masked in the UI and logs. String variables only, without a default." },
        "userEditable": { "type": "boolean", "default": true },
        "pattern": { "type": "string", "maxLength": 1024, "description": "Non-backtracking regular expression; required for strings used in arguments or configuration files." },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "min": { "type": "number", "description": "Integer and number variables; whole for integers." },
        "max": { "type": "number", "description": "Integer and number variables; whole for integers." },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EnumOption" } },
        "description": { "type": "string", "maxLength": 512 },
        "workshop": { "$ref": "#/$defs/WorkshopList" }
      }
    },
    "WorkshopList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId"],
      "description": "The variable lists Steam Workshop item ids; the panel offers an editor that looks them up on Steam.",
      "properties": {
        "appId": { "type": "integer", "minimum": 1, "maximum": 4294967295, "description": "The game's Steam app id (whose Workshop the items are in)." },
        "separator": { "enum": [";", ","], "default": ";" }
      }
    },
    "EnumOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "label": { "type": "string" },
        "map": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Sub-values, used as {{var.<key>.<name>}}." }
      }
    },
    "PortDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "protocols", "default"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocols": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["udp", "tcp"] } },
        "default": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "required": { "type": "boolean", "default": true, "description": "Optional ports can only be used inside { \"if\": \"port.<name>\" } arguments." },
        "description": { "type": "string" },
        "follows": { "$ref": "#/$defs/PortFollow" },
        "internal": { "type": "boolean", "default": false, "description": "Only the agent uses it, on this machine (a game's telnet console): never opened in the firewall." }
      }
    },
    "PortFollow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "offset"],
      "description": "The game opens this port at a fixed distance from another (Valheim: the game port + 1): it gets the allocation of the same address at that port.",
      "properties": {
        "port": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "offset": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "InstallDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/InstallStep" } }
      }
    },
    "InstallStep": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["steamcmd", "ensureDirectory", "writeFileIfMissing", "testGameServer", "minecraftServer", "copyFileIfMissing"] } },
      "oneOf": [
        { "$ref": "#/$defs/SteamCmdStep" },
        { "$ref": "#/$defs/EnsureDirectoryStep" },
        { "$ref": "#/$defs/WriteFileIfMissingStep" },
        { "$ref": "#/$defs/TestGameServerStep" },
        { "$ref": "#/$defs/MinecraftServerStep" },
        { "$ref": "#/$defs/CopyFileIfMissingStep" }
      ]
    },
    "SteamCmdStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "appId"],
      "description": "Installs or updates a Steam app with SteamCMD, as the server's own account.",
      "properties": {
        "type": { "const": "steamcmd" },
        "appId": { "type": "integer", "minimum": 1 },
        "login": {
          "enum": ["anonymous", "account"],
          "default": "anonymous",
          "description": "'account': only a Steam account that owns the dedicated server may download it; the server needs one set in the panel."
        },
        "beta": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "betaPasswordVar": { "type": "string", "description": "A secret variable holding the beta branch password. The agent fails the install (steamcmd.beta_password_invalid) when its value is one SteamCMD would not receive whole: more than 64 characters, spaces, double quotes or control characters, or a leading + or -." },
        "validate": { "type": "boolean", "default": false }
      }
    },
    "EnsureDirectoryStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": { "type": { "const": "ensureDirectory" }, "path": { "$ref": "#/$defs/RelativePath" } }
    },
    "WriteFileIfMissingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "content"],
      "properties": {
        "type": { "const": "writeFileIfMissing" },
        "path": { "$ref": "#/$defs/RelativePath" },
        "content": { "type": "string", "maxLength": 65536, "description": "Literal text (no placeholders)." }
      }
    },
    "TestGameServerStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "description": "Pulsar's own test game server; only for the pulsar-test manifest.",
      "properties": { "type": { "const": "testGameServer" }, "path": { "$ref": "#/$defs/RelativePath" } }
    },
    "MinecraftServerStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Minecraft: Java Edition's server.jar from Mojang and the Java runtime its version needs in java/ (Eclipse Temurin), both checked against their publishers' checksums.",
      "properties": {
        "type": { "const": "minecraftServer" },
        "versionVar": { "type": "string", "description": "A variable holding the version ('1.21.4', or 'latest' for the latest release)." }
      }
    },
    "CopyFileIfMissingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "description": "Copies a file of the server directory to 'to' when that does not exist yet (a game's shipped settings as the server's own).",
      "properties": {
        "type": { "const": "copyFileIfMissing" },
        "from": { "$ref": "#/$defs/RelativePath" },
        "to": { "$ref": "#/$defs/RelativePath" }
      }
    },
    "RuntimeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "console"],
      "properties": {
        "executable": { "$ref": "#/$defs/RelativePath", "pattern": "\\.[eE][xX][eE]$" },
        "workingDirectory": { "$ref": "#/$defs/RelativePath" },
        "arguments": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/ArgumentTemplate" } },
        "allowExtraArguments": { "type": "boolean", "default": false },
        "environment": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }, "additionalProperties": { "type": "string" } },
        "console": { "$ref": "#/$defs/ConsoleDefinition" }
      }
    },
    "ArgumentTemplate": {
      "description": "One argv element, with {{var.<key>}}, {{var.<key>.<sub>}}, {{port.<name>}}, {{port.<name>.ip}}, {{rcon.password}}, {{server.shortId}} or {{server.dir}} placeholders, or a conditional group.",
      "oneOf": [
        { "type": "string", "maxLength": 1024 },
        { "$ref": "#/$defs/ArgumentCondition" }
      ]
    },
    "ArgumentCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["if", "then"],
      "properties": {
        "if": { "type": "string", "pattern": "^(var|port)\\.[A-Za-z][A-Za-z0-9_]*$", "description": "A variable (a boolean when true, any other when it has a value), or an optional port (assigned)." },
        "then": { "type": "array", "items": { "$ref": "#/$defs/ArgumentTemplate" } },
        "else": { "type": "array", "items": { "$ref": "#/$defs/ArgumentTemplate" }, "description": "What goes instead when the condition does not hold." }
      }
    },
    "ConsoleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["pty", "pipes", "logfile+rcon"], "description": "pty: pseudo console; pipes: redirected stdio; logfile+rcon: output from a log file, commands through RCON (Source engine on Windows)." },
        "encoding": { "enum": ["utf-8", "oem", "ansi"], "default": "utf-8" },
        "inputNewline": { "enum": ["\n", "\r\n", "\r"] },
        "sensitiveCommandPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "logFile": { "$ref": "#/$defs/RelativePath" },
        "rcon": { "$ref": "#/$defs/RconDefinition" }
      }
    },
    "RconDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": { "enum": ["source", "telnet"] },
        "port": { "type": "string", "description": "Name of a required port; RCON listens on its TCP side, which only needs to be reachable from the node." },
        "logsCommands": { "type": "boolean", "default": false, "description": "The game writes commands received over RCON to its log file, so the console does not add them again; an answer is added only when the log does not show it." }
      }
    },
    "QueryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": { "enum": ["a2s", "minecraft"], "description": "a2s: Valve's server queries over UDP (Source and most Steam games); minecraft: the Server List Ping over TCP." },
        "port": { "type": "string", "description": "Name of a required port with the protocol's transport (UDP for a2s, TCP for minecraft)." }
      }
    },
    "ConfigFileDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "mode", "set"],
      "properties": {
        "path": { "$ref": "#/$defs/RelativePath" },
        "format": { "enum": ["source-cfg", "properties", "unreal-ini", "key-value", "xml-properties", "colon", "json"], "description": "colon: key: value per line, # comments (SCP: Secret Laboratory). json: members of a JSON object, each key a JSON Pointer (/gameSettings/enemyDamageFactor); patch mode only." },
        "mode": { "enum": ["patch", "managed"], "description": "patch: only the declared keys change; managed: the whole file is written by Pulsar." },
        "set": { "type": "object", "minProperties": 1, "maxProperties": 128, "additionalProperties": { "type": "string" } },
        "section": { "type": "string", "pattern": "^[A-Za-z0-9_./:-]{1,128}$", "description": "unreal-ini: the [section] the keys go into, without its brackets. xml-properties: the root element." },
        "struct": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$", "description": "unreal-ini: the keys are members of this Struct=(Key=Value,...) line instead of plain lines." },
        "keepIfEmpty": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string" }, "description": "Keys of set whose line stays as the file has it when their value is empty (an option left unset); an empty value of another key removes its line." }
      }
    },
    "ReadinessDefinition": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["logPattern", "processAlive", "rcon", "query"] } },
      "oneOf": [
        { "$ref": "#/$defs/LogPatternReadiness" },
        { "$ref": "#/$defs/ProcessAliveReadiness" },
        { "$ref": "#/$defs/RconReadiness" },
        { "$ref": "#/$defs/QueryReadiness" }
      ]
    },
    "LogPatternReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pattern", "timeoutSeconds"],
      "properties": {
        "type": { "const": "logPattern" },
        "pattern": { "type": "string", "maxLength": 1024 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "ProcessAliveReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "graceSeconds"],
      "properties": { "type": { "const": "processAlive" }, "graceSeconds": { "type": "integer", "minimum": 0, "maximum": 600 } }
    },
    "RconReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timeoutSeconds"],
      "properties": { "type": { "const": "rcon" }, "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 } }
    },
    "QueryReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timeoutSeconds"],
      "properties": { "type": { "const": "query" }, "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 } }
    },
    "StopDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "timeoutSeconds"],
      "properties": {
        "steps": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/StopStep" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "description": "After it, the agent kills the whole process tree." }
      }
    },
    "StopStep": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["consoleCommand", "rconCommand", "ctrlC", "wait"] } },
      "oneOf": [
        { "$ref": "#/$defs/ConsoleCommandStop" },
        { "$ref": "#/$defs/RconCommandStop" },
        { "$ref": "#/$defs/CtrlCStop" },
        { "$ref": "#/$defs/WaitStop" }
      ]
    },
    "ConsoleCommandStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": { "type": { "const": "consoleCommand" }, "command": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "RconCommandStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": { "type": { "const": "rconCommand" }, "command": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "CtrlCStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "ctrlC" } }
    },
    "WaitStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seconds"],
      "properties": { "type": { "const": "wait" }, "seconds": { "type": "integer", "minimum": 1, "maximum": 300 } }
    },
    "BackupDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" }, "description": "Globs relative to the server directory. Without them, everything is included." },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "save": { "$ref": "#/$defs/GameSaveDefinition" }
      }
    },
    "GameSaveDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "description": "Console commands that make a running game save before a backup captures its files.",
      "properties": {
        "commands": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": "Sent in order through the server's console (RCON when the console uses it)." },
        "confirmation": { "type": "string", "maxLength": 1024, "description": "Non-backtracking regular expression: the console line that says the save ended." },
        "waitSeconds": { "type": "integer", "minimum": 0, "maximum": 60, "description": "How long to wait after the commands when there is no confirmation." },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "description": "How long to wait for the confirmation (default 60)." },
        "resume": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": "Sent once the files are captured, to undo what the commands paused." }
      }
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?![/\\\\])(?!.*:)(?!.*\\\\)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))(?!(.*/)?[^/]*[. ](/|$))(?!(.*/)? )(?![.][pP][uU][lL][sS][aA][rR](/|$))(?![^./~]{1,6}~[0-9]+(/|$))(?!(.*/)?([cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][0-9¹²³]|[lL][pP][tT][0-9¹²³]) *(\\.[^/]*)?(/|$))(?!.*[^/]{256})[^<>\"|?*\\u0000-\\u001f\\u007f-\\u009f]+$",
      "description": "Relative to the server directory, with forward slashes; no empty, '.' or '..' segments, root, drive or stream, no Windows device names (CON, NUL, COM1…), no name that starts with a space or ends with a dot or a space, no control characters, nothing in Pulsar's own .pulsar folder, names of up to 255 characters."
    }
  }
}
