<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      Releases are self-contained win-x64 builds (scripts/release/Build-Release.ps1): the lock files include that
      runtime, so a release restores in locked mode like every other build. This does not make builds runtime-specific.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Lets Linux CI build the Windows-only agent projects. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Pulsar contributors</Authors>
    <Product>Pulsar</Product>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
