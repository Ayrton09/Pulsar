<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Set to true (e.g. dotnet publish -p:BuildWebClient=true) to compile the React app into wwwroot first. -->
    <BuildWebClient Condition="'$(BuildWebClient)' == ''">false</BuildWebClient>
    <WebClientRoot>$(MSBuildProjectDirectory)\..\Pulsar.Web\</WebClientRoot>
    <UserSecretsId>0614603a-1cd3-4cdd-a59d-13323f2d17df</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.DevTunnels.Ssh" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulsar.Application\Pulsar.Application.csproj" />
    <ProjectReference Include="..\Pulsar.Infrastructure\Pulsar.Infrastructure.csproj" />
    <ProjectReference Include="..\Pulsar.Contracts\Pulsar.Contracts.csproj" />
    <ProjectReference Include="..\Pulsar.Manifests\Pulsar.Manifests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulsar.Api.Tests" />
  </ItemGroup>

  <!--
    The Vite build writes straight into wwwroot (see src/Pulsar.Web/vite.config.ts), so the SPA is picked up
    as regular static web assets (fingerprinting and compression via MapStaticAssets).
    Node.js is only needed when this target runs; the published panel never needs it.
  -->
  <!-- Bundled game manifests (docs/architecture/04), registered as templates at startup. -->
  <ItemGroup>
    <None Include="..\..\games\**\manifest.json" Link="games\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildWebClient" BeforeTargets="BeforeBuild" Condition="'$(BuildWebClient)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebClientRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebClientRoot)" />
    <!--
      wwwroot was globbed when the project was evaluated, before this target ran; Vite empties it and writes new
      hashed file names, so refresh the items or the static web assets would point to the previous build's files.
    -->
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
