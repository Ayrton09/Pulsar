# Normalize line endings in the repository; check out with LF everywhere so
# formatting checks behave the same on Windows and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
*.dll binary
