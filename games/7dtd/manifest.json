{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "7dtd",
  "version": "1.4.2",
  "name": "7 Days to Die",
  "description": "7 Days to Die dedicated server, installed anonymously with SteamCMD (about 17 GB). Its settings live in pulsar-serverconfig.xml, a copy of the game's own serverconfig.xml that its updates leave alone.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 30, "minMemoryMb": 8192 },

  "variables": [
    { "key": "serverName", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^.{1,64}$", "description": "Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for an open server." },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 8, "min": 1, "max": 64 },
    { "key": "world", "label": "World", "type": "string", "default": "Navezgane", "maxLength": 64, "pattern": "^[A-Za-z0-9_ -]{1,64}$",
      "description": "Navezgane, a pregenerated world (Pregen06k01…) or RWG for a random one." },
    { "key": "gameName", "label": "Save name", "type": "string", "default": "Pulsar", "maxLength": 64, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_. -]{0,63}$",
      "description": "Names the save. A new name starts a new game in the same world." },
    { "key": "visibility", "label": "Server list", "type": "enum", "default": "public",
      "options": [
        { "value": "public", "label": "Listed", "map": { "value": "2" } },
        { "value": "friends", "label": "Friends only", "map": { "value": "1" } },
        { "value": "hidden", "label": "Not listed", "map": { "value": "0" } }
      ] },
    { "key": "eac", "label": "EasyAntiCheat", "type": "boolean", "default": true,
      "description": "Most code mods need it off." },
    { "key": "sandboxCode", "label": "Sandbox code", "type": "string", "maxLength": 1024, "pattern": "^[A-Za-z0-9+/=_.-]{1,1024}$",
      "description": "Difficulty, XP, loot, zombies, blood moons and air drops in one code made with the game's Sandbox options (V3.0 and newer)." },
    { "key": "region", "label": "Region", "type": "enum", "options": [
        { "value": "NorthAmericaEast", "label": "North America East" }, { "value": "NorthAmericaWest", "label": "North America West" },
        { "value": "CentralAmerica", "label": "Central America" }, { "value": "SouthAmerica", "label": "South America" },
        { "value": "Europe", "label": "Europe" }, { "value": "Russia", "label": "Russia" }, { "value": "Asia", "label": "Asia" },
        { "value": "MiddleEast", "label": "Middle East" }, { "value": "Africa", "label": "Africa" }, { "value": "Oceania", "label": "Oceania" }
      ],
      "description": "Where players find the server in the list." },
    { "key": "language", "label": "Language", "type": "string", "maxLength": 32, "pattern": "^[A-Za-z0-9 ]{1,32}$",
      "description": "The English name of the language players speak, such as German." },
    { "key": "worldGenSeed", "label": "Random world seed", "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_ -]{1,64}$",
      "description": "Only with the RWG world: the seed of a new world." },
    { "key": "worldGenSize", "label": "Random world size", "type": "enum", "options": [
        { "value": "6144", "label": "6144" }, { "value": "8192", "label": "8192" }, { "value": "10240", "label": "10240" }
      ],
      "description": "Only with the RWG world: width and height of a new world." },
    { "key": "maxAnimals", "label": "Max animals", "type": "integer", "min": 0, "max": 200,
      "description": "Animals alive at once on the whole map." },
    { "key": "viewDistance", "label": "Max view distance", "type": "enum", "options": [
        { "value": "6", "label": "6" }, { "value": "7", "label": "7" }, { "value": "8", "label": "8" }, { "value": "9", "label": "9" },
        { "value": "10", "label": "10" }, { "value": "11", "label": "11" }, { "value": "12", "label": "12" }
      ],
      "description": "Highest view distance a player may ask for. Lower uses less memory." },
    { "key": "landClaimCount", "label": "Land claims per player", "type": "integer", "min": 0, "max": 20 },
    { "key": "landClaimSize", "label": "Land claim size (blocks)", "type": "integer", "min": 1, "max": 200 },
    { "key": "landClaimExpiryTime", "label": "Land claim expiry (days)", "type": "integer", "min": 1, "max": 365,
      "description": "Real days a player can be offline before their claims stop protecting." },
    { "key": "landClaimDecayMode", "label": "Land claim decay", "type": "enum", "options": [
        { "value": "0", "label": "Slow" }, { "value": "1", "label": "Fast" }, { "value": "2", "label": "None until expired" }
      ] },
    { "key": "bedrollExpiryTime", "label": "Bedroll expiry (days)", "type": "integer", "min": 1, "max": 365,
      "description": "Real days a bedroll stays active after its owner was last online." },
    { "key": "safeZoneLevel", "label": "Safe zone up to level", "type": "integer", "min": 0, "max": 300,
      "description": "Players at or under this level get a zone without enemies." },
    { "key": "crossplay", "label": "Crossplay", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Console players join. Needs EasyAntiCheat on and 8 slots at most." },
    { "key": "persistentProfiles", "label": "Persistent player profiles", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Keeps player profiles between sessions." },
    { "key": "buildCreate", "label": "Creative mode", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Lets players build without limits." },
    { "key": "maxZombies", "label": "Max zombies", "type": "integer", "min": 1, "max": 200,
      "description": "Zombies alive at once on the whole map. Over 90 slows most servers down." },
    { "key": "playerKilling", "label": "Player killing", "type": "enum",
      "options": [
        { "value": "0", "label": "No killing" }, { "value": "1", "label": "Kill allies only" },
        { "value": "2", "label": "Kill strangers only" }, { "value": "3", "label": "Kill everyone" }
      ] },
    { "key": "description", "label": "Description", "type": "string", "maxLength": 200, "pattern": "^.{1,200}$" },
    { "key": "website", "label": "Website", "type": "string", "maxLength": 200, "pattern": "^https?://[^\\s<>\"]{1,192}$" }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp", "tcp"], "default": 26900 },
    { "name": "net2", "label": "Game (second port)", "protocols": ["udp"], "default": 26901, "follows": { "port": "game", "offset": 1 } },
    { "name": "net3", "label": "Game (third port)", "protocols": ["udp"], "default": 26902, "follows": { "port": "game", "offset": 2 } },
    { "name": "telnet", "label": "Console (telnet)", "protocols": ["tcp"], "default": 8081, "internal": true,
      "description": "The game's console, used only by Pulsar on this machine (with a password Pulsar generates)." }
  ],

  "install": {
    "steps": [
      { "type": "steamcmd", "appId": 294420 },
      { "type": "copyFileIfMissing", "from": "serverconfig.xml", "to": "pulsar-serverconfig.xml" }
    ]
  },
  "update": {
    "steps": [
      { "type": "steamcmd", "appId": 294420 },
      { "type": "copyFileIfMissing", "from": "serverconfig.xml", "to": "pulsar-serverconfig.xml" }
    ]
  },

  "runtime": {
    "windows-x64": {
      "executable": "7DaysToDieServer.exe",
      "arguments": ["-logfile", "-", "-quit", "-batchmode", "-nographics", "-configfile=pulsar-serverconfig.xml", "-dedicated"],
      "environment": { "SteamAppId": "251570", "SteamGameId": "251570" },
      "console": {
        "mode": "pipes",
        "encoding": "utf-8",
        "rcon": { "protocol": "telnet", "port": "telnet", "logsCommands": true },
        "sensitiveCommandPrefixes": ["admin"]
      }
    }
  },

  "configFiles": [
    { "path": "pulsar-serverconfig.xml", "format": "xml-properties", "mode": "patch", "section": "ServerSettings",
      "set": {
        "ServerName": "{{var.serverName}}",
        "ServerPassword": "{{var.password}}",
        "ServerPort": "{{port.game}}",
        "ServerVisibility": "{{var.visibility.value}}",
        "ServerMaxPlayerCount": "{{var.maxPlayers}}",
        "GameWorld": "{{var.world}}",
        "GameName": "{{var.gameName}}",
        "EACEnabled": "{{var.eac}}",
        "TelnetEnabled": "true",
        "TelnetPort": "{{port.telnet}}",
        "TelnetPassword": "{{rcon.password}}",
        "WebDashboardEnabled": "false",
        "UserDataFolder": "{{server.dir}}/UserData",
        "SandboxCode": "{{var.sandboxCode}}",
        "Region": "{{var.region}}",
        "Language": "{{var.language}}",
        "WorldGenSeed": "{{var.worldGenSeed}}",
        "WorldGenSize": "{{var.worldGenSize}}",
        "MaxSpawnedAnimals": "{{var.maxAnimals}}",
        "ServerMaxAllowedViewDistance": "{{var.viewDistance}}",
        "LandClaimCount": "{{var.landClaimCount}}",
        "LandClaimSize": "{{var.landClaimSize}}",
        "LandClaimExpiryTime": "{{var.landClaimExpiryTime}}",
        "LandClaimDecayMode": "{{var.landClaimDecayMode}}",
        "BedrollExpiryTime": "{{var.bedrollExpiryTime}}",
        "PlayerSafeZoneLevel": "{{var.safeZoneLevel}}",
        "ServerAllowCrossplay": "{{var.crossplay}}",
        "PersistentPlayerProfiles": "{{var.persistentProfiles}}",
        "BuildCreate": "{{var.buildCreate}}",
        "MaxSpawnedZombies": "{{var.maxZombies}}",
        "PlayerKillingMode": "{{var.playerKilling}}",
        "ServerDescription": "{{var.description}}",
        "ServerWebsiteURL": "{{var.website}}"
      },
      "keepIfEmpty": ["ServerName", "SandboxCode", "Region", "Language", "WorldGenSeed", "WorldGenSize", "MaxSpawnedAnimals", "ServerMaxAllowedViewDistance", "LandClaimCount", "LandClaimSize", "LandClaimExpiryTime", "LandClaimDecayMode", "BedrollExpiryTime", "PlayerSafeZoneLevel", "ServerAllowCrossplay", "PersistentPlayerProfiles", "BuildCreate", "MaxSpawnedZombies", "PlayerKillingMode", "ServerDescription", "ServerWebsiteURL"] }
  ],

  "query": { "protocol": "a2s", "port": "game" },
  "readiness": { "type": "logPattern", "pattern": "StartGame done", "timeoutSeconds": 900 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "shutdown" } ],
    "timeoutSeconds": 120
  },

  "backup": {
    "include": ["UserData/Saves/**", "UserData/GeneratedWorlds/**", "pulsar-serverconfig.xml"],
    "save": { "commands": ["saveworld"], "waitSeconds": 10 }
  },
  "commands": {
    "broadcast": "say \"{{message}}\"",
    "players": { "kick": "kick \"{{player}}\"", "ban": "ban add \"{{player}}\" 10 years", "spaces": true }
  }
}
