{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "arma-reforger",
  "version": "1.2.0",
  "name": "Arma Reforger",
  "description": "Arma Reforger dedicated server, installed anonymously with SteamCMD. Its settings are in server.json and its logs, saves and mods in the profile folder of the server.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 12, "minMemoryMb": 8192 },

  "variables": [
    { "key": "name", "label": "Server name", "type": "string", "default": "Pulsar Arma Reforger", "maxLength": 100, "pattern": "^[^\"]{1,100}$" },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[^\" ]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "adminPassword", "label": "Admin password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[^\" ]{3,32}$",
      "description": "Players become administrators with #login and this password." },
    { "key": "scenario", "label": "Scenario", "type": "enum", "default": "conflict-everon",
      "options": [
        { "value": "conflict-everon", "label": "Conflict - Everon", "map": { "id": "{ECC61978EDCC2B5A}Missions/23_Campaign.conf" } },
        { "value": "conflict-north", "label": "Conflict - Northern Everon", "map": { "id": "{C700DB41F0C546E1}Missions/23_Campaign_NorthCentral.conf" } },
        { "value": "conflict-south", "label": "Conflict - Southern Everon", "map": { "id": "{28802845ADA64D52}Missions/23_Campaign_SWCoast.conf" } },
        { "value": "conflict-west", "label": "Conflict - Western Everon", "map": { "id": "{94992A3D7CE4FF8A}Missions/23_Campaign_Western.conf" } },
        { "value": "conflict-montignac", "label": "Conflict - Montignac", "map": { "id": "{FDE33AFE2ED7875B}Missions/23_Campaign_Montignac.conf" } },
        { "value": "conflict-arland", "label": "Conflict - Arland", "map": { "id": "{C41618FD18E9D714}Missions/23_Campaign_Arland.conf" } },
        { "value": "hqc-everon", "label": "Conflict: HQ Commander - Everon", "map": { "id": "{0220741028718E7F}Missions/23_Campaign_HQC_Everon.conf" } },
        { "value": "hqc-arland", "label": "Conflict: HQ Commander - Arland", "map": { "id": "{68D1240A11492545}Missions/23_Campaign_HQC_Arland.conf" } },
        { "value": "hqc-kolguyev", "label": "Conflict: HQ Commander - Kolguyev", "map": { "id": "{BB5345C22DD2B655}Missions/23_Campaign_HQC_Cain.conf" } },
        { "value": "gm-everon", "label": "Game Master - Everon", "map": { "id": "{59AD59368755F41A}Missions/21_GM_Eden.conf" } },
        { "value": "gm-arland", "label": "Game Master - Arland", "map": { "id": "{2BBBE828037C6F4B}Missions/22_GM_Arland.conf" } },
        { "value": "gm-kolguyev", "label": "Game Master - Kolguyev", "map": { "id": "{F45C6C15D31252E6}Missions/27_GM_Cain.conf" } },
        { "value": "combatops-arland", "label": "Combat Ops - Arland", "map": { "id": "{DAA03C6E6099D50F}Missions/24_CombatOps.conf" } },
        { "value": "combatops-everon", "label": "Combat Ops - Everon", "map": { "id": "{DFAC5FABD11F2390}Missions/26_CombatOpsEveron.conf" } },
        { "value": "cah-briars", "label": "Capture & Hold - Briars", "map": { "id": "{3F2E005F43DBD2F8}Missions/CAH_Briars_Coast.conf" } },
        { "value": "cah-castle", "label": "Capture & Hold - Montfort Castle", "map": { "id": "{F1A1BEA67132113E}Missions/CAH_Castle.conf" } },
        { "value": "cah-concrete", "label": "Capture & Hold - Concrete Plant", "map": { "id": "{589945FB9FA7B97D}Missions/CAH_Concrete_Plant.conf" } },
        { "value": "cah-factory", "label": "Capture & Hold - Almara Factory", "map": { "id": "{9405201CBD22A30C}Missions/CAH_Factory.conf" } },
        { "value": "cah-forest", "label": "Capture & Hold - Simon's Wood", "map": { "id": "{1CD06B409C6FAE56}Missions/CAH_Forest.conf" } },
        { "value": "cah-lemoule", "label": "Capture & Hold - Le Moule", "map": { "id": "{7C491B1FCC0FF0E1}Missions/CAH_LeMoule.conf" } },
        { "value": "cah-base", "label": "Capture & Hold - Camp Blake", "map": { "id": "{6EA2E454519E5869}Missions/CAH_Military_Base.conf" } },
        { "value": "cah-morton", "label": "Capture & Hold - Morton", "map": { "id": "{2B4183DF23E88249}Missions/CAH_Morton.conf" } }
      ],
      "description": "The game's multiplayer scenarios, as -listScenarios lists them." },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 32, "min": 1, "max": 128 },
    { "key": "visible", "label": "Server list", "type": "enum", "default": "true",
      "options": [ { "value": "true", "label": "Listed (players find it)" }, { "value": "false", "label": "Not listed (join by address)" } ] },
    { "key": "crossPlatform", "label": "Crossplay (Xbox and PlayStation)", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "thirdPerson", "label": "Third person camera", "type": "enum",
      "options": [ { "value": "false", "label": "Allowed" }, { "value": "true", "label": "Disabled" } ] },
    { "key": "battlEye", "label": "BattlEye", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "viewDistance", "label": "Max view distance (m)", "type": "integer", "min": 500, "max": 10000 },
    { "key": "maxFps", "label": "Server FPS", "type": "integer", "default": 60, "min": 30, "max": 120 },
    { "key": "networkViewDistance", "label": "Network view distance (m)", "type": "integer", "min": 500, "max": 5000,
      "description": "How far away entities are sent to players." },
    { "key": "minGrassDistance", "label": "Min grass distance (m)", "type": "integer", "min": 0, "max": 150,
      "description": "0: players choose. Otherwise 50 to 150 is forced as the minimum." },
    { "key": "fastValidation", "label": "Fast validation", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Faster checks of the map when a player joins." },
    { "key": "vonDisableUi", "label": "Hide voice UI", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "vonDisableDirectUi", "label": "Hide direct speech UI", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "vonCrossFaction", "label": "Radios work across factions", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "playerSaveTime", "label": "Player save period (s)", "type": "integer", "min": 10, "max": 3600 },
    { "key": "aiLimit", "label": "AI limit", "type": "integer", "min": -1, "max": 10000,
      "description": "Most AI characters at once. -1: no limit." },
    { "key": "disableAi", "label": "Disable AI", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "No AI at all, for PvP." },
    { "key": "slotReservationTimeout", "label": "Slot reservation (s)", "type": "integer", "min": 5, "max": 300,
      "description": "How long a disconnected player's slot is kept for them." },
    { "key": "mods", "label": "Mods", "type": "string", "default": "", "maxLength": 2048, "pattern": "^([0-9A-Fa-f]{16}(,[0-9A-Fa-f]{16})*)?$",
      "description": "Mods of the Arma Reforger Workshop, by id, separated by commas. The server downloads them itself when it starts; mods added to server.json by hand stay.",
      "reforgerWorkshop": {} }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 2001, "description": "Players connect here." },
    { "name": "query", "label": "Steam query", "protocols": ["udp"], "default": 17777, "description": "The server list asks here." }
  ],

  "install": { "steps": [
    { "type": "steamcmd", "appId": 1874900 },
    { "type": "writeFileIfMissing", "path": "server.json",
      "content": "{\n  \"bindAddress\": \"0.0.0.0\",\n  \"bindPort\": 2001,\n  \"publicAddress\": \"\",\n  \"publicPort\": 2001,\n  \"a2s\": {\n    \"address\": \"0.0.0.0\",\n    \"port\": 17777\n  },\n  \"game\": {\n    \"name\": \"Pulsar Arma Reforger\",\n    \"password\": \"\",\n    \"passwordAdmin\": \"\",\n    \"scenarioId\": \"{ECC61978EDCC2B5A}Missions/23_Campaign.conf\",\n    \"maxPlayers\": 32,\n    \"visible\": true,\n    \"gameProperties\": {\n      \"serverMaxViewDistance\": 1600,\n      \"networkViewDistance\": 1500,\n      \"disableThirdPerson\": false,\n      \"fastValidation\": true,\n      \"battlEye\": true\n    },\n    \"mods\": []\n  }\n}\n" }
  ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 1874900 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "ArmaReforgerServer.exe",
      "arguments": [
        "-config", "{{server.dir}}/server.json",
        "-profile", "{{server.dir}}/profile",
        "-maxFPS", "{{var.maxFps}}"
      ],
      "allowExtraArguments": true,
      "console": { "mode": "pty", "encoding": "utf-8" }
    }
  },

  "configFiles": [
    { "path": "server.json", "format": "json", "mode": "patch",
      "set": {
        "/bindAddress": "{{port.game.ip}}",
        "/bindPort": "{{port.game}}",
        "/publicPort": "{{port.game}}",
        "/a2s/address": "{{port.query.ip}}",
        "/a2s/port": "{{port.query}}",
        "/game/name": "{{var.name}}",
        "/game/password": "{{var.password}}",
        "/game/passwordAdmin": "{{var.adminPassword}}",
        "/game/scenarioId": "{{var.scenario.id}}",
        "/game/maxPlayers": "{{var.maxPlayers}}",
        "/game/visible": "{{var.visible}}",
        "/game/crossPlatform": "{{var.crossPlatform}}",
        "/game/gameProperties/disableThirdPerson": "{{var.thirdPerson}}",
        "/game/gameProperties/battlEye": "{{var.battlEye}}",
        "/game/gameProperties/serverMaxViewDistance": "{{var.viewDistance}}",
        "/game/gameProperties/networkViewDistance": "{{var.networkViewDistance}}",
        "/game/gameProperties/serverMinGrassDistance": "{{var.minGrassDistance}}",
        "/game/gameProperties/fastValidation": "{{var.fastValidation}}",
        "/game/gameProperties/VONDisableUI": "{{var.vonDisableUi}}",
        "/game/gameProperties/VONDisableDirectSpeechUI": "{{var.vonDisableDirectUi}}",
        "/game/gameProperties/VONCanTransmitCrossFaction": "{{var.vonCrossFaction}}",
        "/operating/playerSaveTime": "{{var.playerSaveTime}}",
        "/operating/aiLimit": "{{var.aiLimit}}",
        "/operating/disableAI": "{{var.disableAi}}",
        "/operating/slotReservationTimeout": "{{var.slotReservationTimeout}}"
      },
      "keepIfEmpty": ["/game/crossPlatform", "/game/gameProperties/disableThirdPerson", "/game/gameProperties/battlEye",
        "/game/gameProperties/serverMaxViewDistance",
        "/game/gameProperties/networkViewDistance", "/game/gameProperties/serverMinGrassDistance", "/game/gameProperties/fastValidation", "/game/gameProperties/VONDisableUI", "/game/gameProperties/VONDisableDirectSpeechUI", "/game/gameProperties/VONCanTransmitCrossFaction", "/operating/playerSaveTime", "/operating/aiLimit", "/operating/disableAI", "/operating/slotReservationTimeout"],
      "lists": { "/game/mods": { "variable": "mods", "key": "modId" } } }
  ],

  "query": { "protocol": "a2s", "port": "query" },
  "readiness": { "type": "query", "timeoutSeconds": 900 },

  "stop": {
    "steps": [ { "type": "ctrlC" } ],
    "timeoutSeconds": 90
  },

  "backup": {
    "include": ["server.json", "profile/**"],
    "exclude": ["profile/logs/**", "profile/addons/**"]
  }
}
