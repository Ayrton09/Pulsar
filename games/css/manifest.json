{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "css",
  "version": "1.4.2",
  "name": "Counter-Strike: Source",
  "description": "Counter-Strike: Source dedicated server (srcds), installed anonymously with SteamCMD.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 4, "minMemoryMb": 1024 },

  "variables": [
    { "key": "hostname", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^[^\";]{1,64}$", "description": "Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "map", "label": "Starting map", "type": "string", "default": "de_dust2", "maxLength": 64, "pattern": "^[A-Za-z0-9_]{1,64}$" },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 16, "min": 2, "max": 64 },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "tickrate", "label": "Tick rate", "type": "enum",
      "options": [ { "value": "66", "label": "66 (the game's)" }, { "value": "100", "label": "100" } ],
      "description": "Updates per second. 100 is smoother and uses more CPU and bandwidth." },
    { "key": "friendlyFire", "label": "Friendly fire", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Teammates can hurt each other." },
    { "key": "maxRounds", "label": "Max rounds", "type": "integer", "min": 0, "max": 100,
      "description": "Rounds a match lasts. 0: no limit." },
    { "key": "timeLimit", "label": "Map time limit (min)", "type": "integer", "min": 0, "max": 1440,
      "description": "Minutes before the map changes. 0: no limit." },
    { "key": "winLimit", "label": "Win limit", "type": "integer", "min": 0, "max": 100,
      "description": "Rounds a team must win to end the map. 0: no limit." },
    { "key": "roundTime", "label": "Round time (min)", "type": "number", "min": 1, "max": 9,
      "description": "Minutes a round lasts." },
    { "key": "freezeTime", "label": "Freeze time (s)", "type": "integer", "min": 0, "max": 60,
      "description": "Seconds players cannot move at the start of a round." },
    { "key": "startMoney", "label": "Start money", "type": "integer", "min": 0, "max": 16000 },
    { "key": "autoTeamBalance", "label": "Auto team balance", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "limitTeams", "label": "Max team size difference", "type": "integer", "min": 0, "max": 30,
      "description": "How many more players one team may have than the other. 0: no limit." },
    { "key": "c4Timer", "label": "C4 timer (s)", "type": "integer", "min": 10, "max": 90 },
    { "key": "allTalk", "label": "All talk", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Both teams hear each other on voice chat." },
    { "key": "bots", "label": "Bots", "type": "integer", "min": 0, "max": 32,
      "description": "How many bots fill the server." },
    { "key": "tags", "label": "Server tags", "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_,-]{1,128}$",
      "description": "Comma-separated tags shown in the server browser." },
    { "key": "region", "label": "Region", "type": "enum",
      "options": [ { "value": "-1", "label": "None" }, { "value": "0", "label": "US East" }, { "value": "1", "label": "US West" }, { "value": "2", "label": "South America" },
                   { "value": "3", "label": "Europe" }, { "value": "4", "label": "Asia" }, { "value": "5", "label": "Australia" }, { "value": "6", "label": "Middle East" }, { "value": "7", "label": "Africa" }, { "value": "255", "label": "World" } ],
      "description": "Region shown in the server browser." },
    { "key": "steamGroup", "label": "Steam group ID", "type": "integer", "min": 1, "max": 4294967295,
      "description": "Links the server to this Steam group." },
    { "key": "lan", "label": "LAN only", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Not listed on the internet and players are not authenticated." },
    { "key": "cheats", "label": "Cheats", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Players can use cheat commands." },
    { "key": "voice", "label": "Voice chat", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "allowSpectators", "label": "Spectators", "type": "enum", "options": [ { "value": "1", "label": "Allowed" }, { "value": "0", "label": "Not allowed" } ] },
    { "key": "forceCamera", "label": "Dead players spectate own team only", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "fragLimit", "label": "Frag limit", "type": "integer", "min": 0, "max": 1000,
      "description": "Kills at which the map ends. 0: no limit." },
    { "key": "footsteps", "label": "Footsteps", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "downloadUrl", "label": "Fast download URL", "type": "string", "maxLength": 200, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,190}$",
      "description": "Where players download custom maps and files instead of the server." },
    { "key": "allowDownload", "label": "Allow downloads", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "pausable", "label": "Players can pause", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ] },
    { "key": "pure", "label": "Pure server", "type": "enum",
      "options": [ { "value": "-1", "label": "Off" }, { "value": "0", "label": "pure_server_minimal.txt only" }, { "value": "1", "label": "Full rules plus whitelist" }, { "value": "2", "label": "Full rules" } ],
      "description": "Which client files are allowed." },
    { "key": "maxRate", "label": "Max client rate", "type": "integer", "min": 0, "max": 1000000,
      "description": "Bytes per second a client may use. 0: no limit." },
    { "key": "maxUpdateRate", "label": "Max update rate", "type": "integer", "min": 10, "max": 100,
      "description": "Updates per second sent to a client. Use 100 on a tick rate 100 server." },
    { "key": "tvAutorecord", "label": "Record SourceTV demos", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ] }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 27015,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." },
    { "name": "tv", "label": "SourceTV", "protocols": ["udp"], "default": 27020, "required": false, "description": "Assign it to enable SourceTV." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 232330 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 232330 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "srcds.exe",
      "arguments": [
        "-game", "cstrike",
        "-console", "-condebug", "-nocrashdialog",
        "-ip", "{{port.game.ip}}",
        "-port", "{{port.game}}",
        { "if": "var.tickrate", "then": ["-tickrate", "{{var.tickrate}}"] },
        { "if": "port.tv", "then": ["+tv_enable", "1", "+tv_port", "{{port.tv}}"] },
        "+maxplayers", "{{var.maxPlayers}}",
        "+map", "{{var.map}}",
        "+rcon_password", "{{rcon.password}}",
        "+sv_rcon_maxfailures", "5",
        "+sv_rcon_banpenalty", "30"
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "logfile+rcon",
        "logFile": "cstrike/console.log",
        "rcon": { "protocol": "source", "port": "game" },
        "sensitiveCommandPrefixes": ["rcon_password", "sv_password"]
      }
    }
  },

  "configFiles": [
    { "path": "cstrike/cfg/server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "hostname": "{{var.hostname}}", "sv_password": "{{var.password}}",
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_timelimit": "{{var.timeLimit}}",
        "mp_winlimit": "{{var.winLimit}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "sv_tags": "{{var.tags}}",
        "sv_region": "{{var.region}}",
        "sv_steamgroup": "{{var.steamGroup}}",
        "sv_lan": "{{var.lan}}",
        "sv_cheats": "{{var.cheats}}",
        "sv_voiceenable": "{{var.voice}}",
        "mp_allowspectators": "{{var.allowSpectators}}",
        "mp_forcecamera": "{{var.forceCamera}}",
        "mp_fraglimit": "{{var.fragLimit}}",
        "mp_footsteps": "{{var.footsteps}}",
        "sv_downloadurl": "{{var.downloadUrl}}",
        "sv_allowdownload": "{{var.allowDownload}}",
        "sv_pausable": "{{var.pausable}}",
        "sv_pure": "{{var.pure}}",
        "sv_maxrate": "{{var.maxRate}}",
        "sv_maxupdaterate": "{{var.maxUpdateRate}}",
        "tv_autorecord": "{{var.tvAutorecord}}"
      },
      "keepIfEmpty": ["hostname", "mp_friendlyfire", "mp_maxrounds", "mp_timelimit", "mp_winlimit", "mp_roundtime", "mp_freezetime", "mp_startmoney", "mp_autoteambalance", "mp_limitteams", "mp_c4timer", "sv_alltalk", "bot_quota", "sv_tags", "sv_region", "sv_steamgroup", "sv_lan", "sv_cheats", "sv_voiceenable", "mp_allowspectators", "mp_forcecamera", "mp_fraglimit", "mp_footsteps", "sv_downloadurl", "sv_allowdownload", "sv_pausable", "sv_pure", "sv_maxrate", "sv_maxupdaterate", "tv_autorecord"] }
  ],

  "query": { "protocol": "a2s", "port": "game" },
  "readiness": { "type": "rcon", "timeoutSeconds": 180 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "quit" } ],
    "timeoutSeconds": 30
  },

  "backup": {
    "include": ["cstrike/cfg/**", "cstrike/addons/**", "cstrike/custom/**", "cstrike/maps/**", "cstrike/mapcycle.txt", "cstrike/motd.txt"],
    "exclude": ["**/*.log", "**/*.dmp"]
  },
  "commands": { "broadcast": "say {{message}}", "players": { "kick": "kick \"{{player}}\"", "spaces": true } }
}
