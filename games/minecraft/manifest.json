{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "minecraft",
  "version": "1.4.0",
  "name": "Minecraft: Java Edition",
  "description": "Minecraft: Java Edition's dedicated server, downloaded from Mojang (or Paper, Purpur, Fabric, Forge or NeoForge from their publishers), with the Java runtime its version needs (Eclipse Temurin, from Adoptium). Players need Minecraft: Java Edition of the same version, and the same mods on Fabric, Forge or NeoForge.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 3, "minMemoryMb": 4096 },

  "variables": [
    { "key": "eula", "label": "Minecraft EULA", "type": "enum", "required": true,
      "options": [ { "value": "accepted", "label": "I accept it", "map": { "flag": "true" } } ],
      "description": "Mojang's terms: https://aka.ms/MinecraftEULA. Its server does not run without accepting them." },
    { "key": "version", "label": "Minecraft version", "type": "string", "default": "latest", "maxLength": 32,
      "pattern": "^(latest|[0-9A-Za-z][0-9A-Za-z._-]{0,31})$",
      "description": "'latest' for the latest release, or a version such as 1.21.4. Changing it takes an update; going back to an older version can damage the world." },
    { "key": "serverType", "label": "Server type", "type": "enum", "default": "vanilla",
      "options": [
        { "value": "vanilla", "label": "Vanilla (Mojang)", "map": { "jar": "server.jar", "argfile": "" } },
        { "value": "paper", "label": "Paper (plugins)", "map": { "jar": "server.jar", "argfile": "" } },
        { "value": "purpur", "label": "Purpur (plugins)", "map": { "jar": "server.jar", "argfile": "" } },
        { "value": "fabric", "label": "Fabric (mods)", "map": { "jar": "fabric-server-launch.jar", "argfile": "" } },
        { "value": "forge", "label": "Forge (mods)", "map": { "jar": "", "argfile": ".pulsar/minecraft-args.txt" } },
        { "value": "neoforge", "label": "NeoForge (mods)", "map": { "jar": "", "argfile": ".pulsar/minecraft-args.txt" } }
      ],
      "description": "Paper and Purpur run Bukkit plugins; Fabric, Forge and NeoForge run mods. With 'latest', the newest Minecraft version the type supports. Changing it takes an update, which installs the new type. The world stays, but may not load on another type: Paper's and Purpur's worlds need their data pack, and a world made with mods needs them. Back it up first." },
    { "key": "loaderVersion", "label": "Loader version", "type": "string", "default": "", "maxLength": 32,
      "pattern": "^([0-9A-Za-z][0-9A-Za-z._+-]{0,31})?$",
      "description": "Fabric's loader, Forge's or NeoForge's version (such as 0.20.1, 58.1.26 or 21.1.265); empty for the recommended one. A Forge version needs its Minecraft version set too." },
    { "key": "motd", "label": "Message of the day", "type": "string", "default": "A Minecraft server on Pulsar", "maxLength": 59,
      "pattern": "^[^\\\\]{0,59}$" },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 20, "min": 1, "max": 500 },
    { "key": "memoryMb", "label": "Memory (MB)", "type": "integer", "default": 2048, "min": 512, "max": 65536,
      "description": "The most memory Java may use for the server." },
    { "key": "difficulty", "label": "Difficulty", "type": "enum", "default": "easy",
      "options": [
        { "value": "peaceful", "label": "Peaceful" }, { "value": "easy", "label": "Easy" },
        { "value": "normal", "label": "Normal" }, { "value": "hard", "label": "Hard" }
      ] },
    { "key": "gamemode", "label": "Game mode", "type": "enum", "default": "survival",
      "options": [
        { "value": "survival", "label": "Survival" }, { "value": "creative", "label": "Creative" },
        { "value": "adventure", "label": "Adventure" }, { "value": "spectator", "label": "Spectator" }
      ] },
    { "key": "onlineMode", "label": "Check accounts with Mojang", "type": "boolean", "default": true,
      "description": "Turn it off only behind a proxy that checks them: anyone could join with any name." },
    { "key": "whitelist", "label": "Only players on the whitelist", "type": "boolean", "default": false },
    { "key": "pvp", "label": "Players can hurt each other", "type": "boolean", "default": true,
      "description": "Only applies to Minecraft 1.21.8 and older: newer versions use the pvp game rule instead." },
    { "key": "seed", "label": "World seed", "type": "string", "default": "", "maxLength": 64, "pattern": "^[^\\\\]{0,64}$",
      "description": "Only used when the world is created." },
    { "key": "viewDistance", "label": "View distance (chunks)", "type": "integer", "default": 10, "min": 3, "max": 32 },
    { "key": "simulationDistance", "label": "Simulation distance (chunks)", "type": "integer", "min": 3, "max": 32,
      "description": "How far from players mobs move and crops grow. Lower uses less CPU." },
    { "key": "hardcore", "label": "Hardcore", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Players who die become spectators. Set it before the world is created." },
    { "key": "spawnProtection", "label": "Spawn protection (blocks)", "type": "integer", "min": 0, "max": 1000,
      "description": "Only operators build this close to the spawn. 0 turns it off." },
    { "key": "allowFlight", "label": "Allow flight", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Players who fly in survival (with mods) are not kicked." },
    { "key": "forceGamemode", "label": "Force the game mode", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Players get the server's game mode every time they join." },
    { "key": "enforceWhitelist", "label": "Kick players not on the whitelist", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "When the whitelist is reloaded, players no longer on it are kicked." },
    { "key": "generateStructures", "label": "Generate structures", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Villages, temples and other structures. Only for chunks generated from then on." },
    { "key": "idleTimeout", "label": "Kick idle players after (min)", "type": "integer", "min": 0, "max": 1440,
      "description": "0: never." },
    { "key": "opPermissionLevel", "label": "Operator permission level", "type": "enum",
      "options": [
        { "value": "1", "label": "1: build in the spawn" }, { "value": "2", "label": "2: cheat commands" },
        { "value": "3", "label": "3: kick and ban" }, { "value": "4", "label": "4: every command" }
      ] },
    { "key": "hideOnlinePlayers", "label": "Hide online players", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "The server list does not show who is playing." },
    { "key": "maxTickTime", "label": "Max tick time (ms)", "type": "integer", "min": -1, "max": 2147483647,
      "description": "A tick longer than this stops the server. -1: never." },
    { "key": "secureProfile", "label": "Require signed chat keys", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Players need Mojang-signed chat keys to join." },
    { "key": "maxWorldSize", "label": "World border radius", "type": "integer", "min": 1, "max": 29999984,
      "description": "Blocks from the center." },
    { "key": "entityRange", "label": "Entity range (%)", "type": "integer", "min": 10, "max": 1000,
      "description": "How far away entities are sent to players, as a percentage." },
    { "key": "pauseWhenEmpty", "label": "Pause when empty (s)", "type": "integer", "min": -1, "max": 86400,
      "description": "Seconds with nobody online before the server pauses (1.21.2 and newer). -1: never." },
    { "key": "resourcePack", "label": "Resource pack URL", "type": "string", "maxLength": 255, "pattern": "^https?://[^\\s\\\\]{1,240}$",
      "description": "Players are offered this resource pack when they join." },
    { "key": "resourcePackSha1", "label": "Resource pack SHA-1", "type": "string", "maxLength": 40, "pattern": "^[A-Fa-f0-9]{40}$",
      "description": "The pack's SHA-1 hash, so clients can check it." },
    { "key": "requireResourcePack", "label": "Require the resource pack", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Players who decline the pack are disconnected." },
    { "key": "resourcePackPrompt", "label": "Resource pack message", "type": "string", "maxLength": 120, "pattern": "^[^\\\\]{1,120}$",
      "description": "Text shown to players when the pack is offered." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["tcp"], "default": 25565 }
  ],

  "install": { "steps": [ { "type": "minecraftServer", "versionVar": "version", "typeVar": "serverType", "loaderVar": "loaderVersion" } ] },
  "update": { "steps": [ { "type": "minecraftServer", "versionVar": "version", "typeVar": "serverType", "loaderVar": "loaderVersion" } ] },

  "runtime": {
    "windows-x64": {
      "executable": "java/bin/java.exe",
      "arguments": [
        "-Xmx{{var.memoryMb}}M",
        "-Dstdout.encoding=UTF-8", "-Dstderr.encoding=UTF-8",
        { "if": "var.serverType.argfile", "then": ["@{{var.serverType.argfile}}"], "else": ["-jar", "{{var.serverType.jar}}"] },
        "--nogui"
      ],
      "allowExtraArguments": false,
      "console": { "mode": "pipes", "encoding": "utf-8" }
    }
  },

  "configFiles": [
    { "path": "eula.txt", "format": "properties", "mode": "patch", "set": { "eula": "{{var.eula.flag}}" } },
    { "path": "server.properties", "format": "properties", "mode": "patch",
      "set": {
        "server-ip": "{{port.game.ip}}",
        "server-port": "{{port.game}}",
        "motd": "{{var.motd}}",
        "max-players": "{{var.maxPlayers}}",
        "difficulty": "{{var.difficulty}}",
        "gamemode": "{{var.gamemode}}",
        "online-mode": "{{var.onlineMode}}",
        "white-list": "{{var.whitelist}}",
        "pvp": "{{var.pvp}}",
        "level-seed": "{{var.seed}}",
        "view-distance": "{{var.viewDistance}}",
        "simulation-distance": "{{var.simulationDistance}}",
        "hardcore": "{{var.hardcore}}",
        "spawn-protection": "{{var.spawnProtection}}",
        "allow-flight": "{{var.allowFlight}}",
        "force-gamemode": "{{var.forceGamemode}}",
        "enforce-whitelist": "{{var.enforceWhitelist}}",
        "generate-structures": "{{var.generateStructures}}",
        "player-idle-timeout": "{{var.idleTimeout}}",
        "op-permission-level": "{{var.opPermissionLevel}}",
        "hide-online-players": "{{var.hideOnlinePlayers}}",
        "max-tick-time": "{{var.maxTickTime}}",
        "enforce-secure-profile": "{{var.secureProfile}}",
        "max-world-size": "{{var.maxWorldSize}}",
        "entity-broadcast-range-percentage": "{{var.entityRange}}",
        "pause-when-empty-seconds": "{{var.pauseWhenEmpty}}",
        "resource-pack": "{{var.resourcePack}}",
        "resource-pack-sha1": "{{var.resourcePackSha1}}",
        "require-resource-pack": "{{var.requireResourcePack}}",
        "resource-pack-prompt": "{{var.resourcePackPrompt}}"
      },
      "keepIfEmpty": ["level-seed", "simulation-distance", "hardcore", "spawn-protection", "allow-flight", "force-gamemode", "enforce-whitelist",
        "generate-structures", "player-idle-timeout", "op-permission-level", "hide-online-players",
        "max-tick-time", "enforce-secure-profile", "max-world-size", "entity-broadcast-range-percentage", "pause-when-empty-seconds", "resource-pack", "resource-pack-sha1", "require-resource-pack", "resource-pack-prompt"] }
  ],

  "query": { "protocol": "minecraft", "port": "game" },
  "readiness": { "type": "logPattern", "pattern": "Done \\([0-9.,]+s\\)! For help, type", "timeoutSeconds": 600 },

  "stop": {
    "steps": [ { "type": "consoleCommand", "command": "stop" } ],
    "timeoutSeconds": 90
  },

  "backup": {
    "include": ["world/**", "world_nether/**", "world_the_end/**", "*.properties", "*.json", "*.yml", "*.yaml", "*.toml",
      "plugins/**", "mods/**", "config/**", "defaultconfigs/**"],
    "save": { "commands": ["save-off", "save-all flush"], "confirmation": "INFO\\]: Saved the game\\r?$", "timeoutSeconds": 120, "resume": ["save-on"] }
  },
  "commands": { "broadcast": "say {{message}}" },
  "mods": [
    { "source": "modrinth", "versionVar": "version", "typeVar": "serverType",
      "types": {
        "paper": { "projectType": "plugin", "loaders": ["paper", "spigot", "bukkit"], "folder": "plugins" },
        "purpur": { "projectType": "plugin", "loaders": ["purpur", "paper", "spigot", "bukkit"], "folder": "plugins" },
        "fabric": { "projectType": "mod", "loaders": ["fabric"], "folder": "mods" },
        "forge": { "projectType": "mod", "loaders": ["forge"], "folder": "mods" },
        "neoforge": { "projectType": "mod", "loaders": ["neoforge"], "folder": "mods" }
      } }
  ]
}
