{
  "schemaVersion": 1,
  "key": "pulsar-test",
  "version": "1.1.0",
  "name": "Pulsar test server",
  "description": "A fake game server for developing and testing Pulsar. Only offered when the panel enables the test game.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "variables": [
    { "key": "readyAfterMs", "label": "Startup time (ms)", "type": "integer", "default": 1000, "min": 0, "max": 600000 },
    { "key": "ignoreQuit", "label": "Ignore the quit command", "type": "boolean", "default": false,
      "description": "Makes the graceful stop time out, so the agent has to kill the server." },
    { "key": "message", "label": "Greeting", "type": "string", "default": "hello", "maxLength": 32, "pattern": "^[A-Za-z0-9 ]{0,32}$" }
  ],

  "install": {
    "steps": [
      { "type": "testGameServer", "path": "bin" },
      { "type": "ensureDirectory", "path": "data" }
    ]
  },

  "update": {
    "steps": [
      { "type": "ensureDirectory", "path": "data" }
    ]
  },

  "runtime": {
    "windows-x64": {
      "executable": "bin/Pulsar.TestGameServer.exe",
      "workingDirectory": "data",
      "arguments": [
        "--ready-after", "{{var.readyAfterMs}}",
        { "if": "var.ignoreQuit", "then": ["--ignore-quit"] }
      ],
      "allowExtraArguments": false,
      "environment": { "PULSAR_TEST_GREETING": "{{var.message}}", "PULSAR_TEST_SERVER": "{{server.shortId}}" },
      "console": { "mode": "pty", "inputNewline": "\r\n" }
    }
  },

  "readiness": { "type": "logPattern", "pattern": "^Test server ready", "timeoutSeconds": 60 },

  "stop": {
    "steps": [ { "type": "consoleCommand", "command": "quit" } ],
    "timeoutSeconds": 15
  },

  "backup": {
    "save": { "commands": ["save-off", "save"], "confirmation": "^Test server: saved", "timeoutSeconds": 15, "resume": ["save-on"] }
  },

  "commands": { "broadcast": "say {{message}}" }
}
