{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "valheim",
  "version": "1.3.2",
  "name": "Valheim",
  "description": "Valheim dedicated server, installed anonymously with SteamCMD (about 2 GB). The world is saved in the server folder.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 4, "minMemoryMb": 4096 },

  "variables": [
    { "key": "name", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^[^\"]{1,64}$",
      "description": "Shown in the server list. It cannot contain the password. Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "world", "label": "World", "type": "string", "default": "Dedicated", "maxLength": 64, "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Its name: a new name makes a new world." },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "required": true, "maxLength": 32, "pattern": "^[^\" ]{5,32}$",
      "description": "Players need it to join: 5 characters at least, and not part of the server name." },
    { "key": "visibility", "label": "Server list", "type": "enum", "default": "public",
      "options": [
        { "value": "public", "label": "Listed (players find it)", "map": { "public": "1" } },
        { "value": "private", "label": "Not listed (join by address)", "map": { "public": "0" } }
      ] },
    { "key": "crossplay", "label": "Crossplay (Xbox and Game Pass players)", "type": "boolean", "default": false,
      "description": "Joins through PlayFab's relay instead of the server's ports." },
    { "key": "preset", "label": "Difficulty", "type": "enum", "default": "normal",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "casual", "label": "Casual" },
        { "value": "easy", "label": "Easy" },
        { "value": "hard", "label": "Hard" },
        { "value": "hardcore", "label": "Hardcore" },
        { "value": "immersive", "label": "Immersive" },
        { "value": "hammer", "label": "Hammer (build mode)" }
      ] },
    { "key": "combat", "label": "Combat", "type": "enum",
      "options": [ { "value": "veryeasy", "label": "Very easy" }, { "value": "easy", "label": "Easy" }, { "value": "hard", "label": "Hard" }, { "value": "veryhard", "label": "Very hard" } ],
      "description": "How hard enemies hit. Changes the difficulty above." },
    { "key": "deathPenalty", "label": "Death penalty", "type": "enum",
      "options": [ { "value": "casual", "label": "Casual" }, { "value": "veryeasy", "label": "Very easy" }, { "value": "easy", "label": "Easy" }, { "value": "hard", "label": "Hard" }, { "value": "hardcore", "label": "Hardcore" } ] },
    { "key": "resources", "label": "Resources", "type": "enum",
      "options": [ { "value": "muchless", "label": "Much less" }, { "value": "less", "label": "Less" }, { "value": "more", "label": "More" }, { "value": "muchmore", "label": "Much more" }, { "value": "most", "label": "Most" } ] },
    { "key": "raids", "label": "Raids", "type": "enum",
      "options": [ { "value": "none", "label": "None" }, { "value": "muchless", "label": "Much less" }, { "value": "less", "label": "Less" }, { "value": "more", "label": "More" }, { "value": "muchmore", "label": "Much more" } ] },
    { "key": "portals", "label": "Portals", "type": "enum",
      "options": [ { "value": "casual", "label": "Anything goes through" }, { "value": "hard", "label": "No metals" }, { "value": "veryhard", "label": "No portals" } ] },
    { "key": "noMap", "label": "No map", "type": "boolean", "default": false },
    { "key": "noBuildCost", "label": "No build cost", "type": "boolean", "default": false },
    { "key": "passiveMobs", "label": "Passive enemies", "type": "boolean", "default": false,
      "description": "Enemies only fight back." },
    { "key": "playerEvents", "label": "Raids by player progress", "type": "boolean", "default": false,
      "description": "Raids follow each player's progress instead of the world's." },
    { "key": "saveInterval", "label": "Autosave every (s)", "type": "integer", "min": 300, "max": 7200 },
    { "key": "backups", "label": "Backups kept", "type": "integer", "min": 0, "max": 50,
      "description": "How many automatic world backups the game keeps. 4 is the game's own." },
    { "key": "backupShort", "label": "First backup after (s)", "type": "integer", "min": 300, "max": 86400,
      "description": "Seconds between the first automatic backups. 7200 is the game's own." },
    { "key": "backupLong", "label": "Later backups every (s)", "type": "integer", "min": 600, "max": 604800,
      "description": "Seconds between the later automatic backups. 43200 is the game's own." },
    { "key": "fireHazards", "label": "Fire hazards", "type": "boolean", "default": false,
      "description": "Fire spreads realistically." },
    { "key": "instanceId", "label": "Crossplay instance id", "type": "string", "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Only when several crossplay servers share one public address." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 2456, "description": "Players connect here." },
    { "name": "query", "label": "Steam query", "protocols": ["udp"], "default": 2457, "follows": { "port": "game", "offset": 1 },
      "description": "Valheim always opens the game port + 1 for the server list: Pulsar gives it that allocation." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 896660 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 896660 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "valheim_server.exe",
      "arguments": [
        "-nographics", "-batchmode",
        { "if": "var.name", "then": ["-name", "{{var.name}}"] },
        "-port", "{{port.game}}",
        "-world", "{{var.world}}",
        "-password", "{{var.password}}",
        "-public", "{{var.visibility.public}}",
        "-preset", "{{var.preset}}",
        { "if": "var.combat", "then": ["-modifier", "combat", "{{var.combat}}"] },
        { "if": "var.deathPenalty", "then": ["-modifier", "deathpenalty", "{{var.deathPenalty}}"] },
        { "if": "var.resources", "then": ["-modifier", "resources", "{{var.resources}}"] },
        { "if": "var.raids", "then": ["-modifier", "raids", "{{var.raids}}"] },
        { "if": "var.portals", "then": ["-modifier", "portals", "{{var.portals}}"] },
        { "if": "var.noMap", "then": ["-setkey", "nomap"] },
        { "if": "var.noBuildCost", "then": ["-setkey", "nobuildcost"] },
        { "if": "var.passiveMobs", "then": ["-setkey", "passivemobs"] },
        { "if": "var.playerEvents", "then": ["-setkey", "playerevents"] },
        { "if": "var.saveInterval", "then": ["-saveinterval", "{{var.saveInterval}}"] },
        { "if": "var.backups", "then": ["-backups", "{{var.backups}}"] },
        { "if": "var.backupShort", "then": ["-backupshort", "{{var.backupShort}}"] },
        { "if": "var.backupLong", "then": ["-backuplong", "{{var.backupLong}}"] },
        { "if": "var.fireHazards", "then": ["-setkey", "fire"] },
        { "if": "var.instanceId", "then": ["-instanceid", "{{var.instanceId}}"] },
        "-savedir", "saves",
        { "if": "var.crossplay", "then": ["-crossplay"] }
      ],
      "environment": { "SteamAppId": "892970" },
      "allowExtraArguments": true,
      "console": { "mode": "pty", "encoding": "utf-8" }
    }
  },

  "query": { "protocol": "a2s", "port": "query" },
  "readiness": { "type": "logPattern", "pattern": "Registering lobby", "timeoutSeconds": 600 },

  "stop": {
    "steps": [ { "type": "ctrlC" } ],
    "timeoutSeconds": 60
  },

  "backup": {
    "include": ["saves/**", "BepInEx/config/**"],
    "exclude": ["**/*.old", "saves/worlds_local/*.fwl.old"]
  },

  "addons": [
    { "key": "bepinex", "name": "BepInEx", "license": "LGPL-2.1", "url": "https://thunderstore.io/c/valheim/p/denikson/BepInExPack_Valheim/",
      "description": "The mod loader Valheim's server mods run on, as packed for Valheim on Thunderstore. Its mods go in BepInEx/plugins.",
      "source": { "type": "thunderstore", "package": "denikson-BepInExPack_Valheim", "folder": "BepInExPack_Valheim" } }
  ],

  "mods": [
    { "source": "thunderstore", "community": "valheim", "category": "server-side", "addonTypes": true,
      "types": {
        "bepinex": { "projectType": "mod", "folder": "BepInEx", "layout": "bepinex" }
      } }
  ]
}
