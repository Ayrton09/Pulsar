{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "l4d2",
  "version": "1.3.2",
  "name": "Left 4 Dead 2",
  "description": "Left 4 Dead 2 dedicated server (srcds), installed anonymously with SteamCMD (about 10 GB).",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 16, "minMemoryMb": 2048 },

  "variables": [
    { "key": "hostname", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^[^\";]{1,64}$", "description": "Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "map", "label": "Starting map", "type": "string", "default": "c1m1_hotel", "maxLength": 64, "pattern": "^[A-Za-z0-9_]{1,64}$",
      "description": "c1m1_hotel starts Dead Center. Players choose the game mode in their lobby." },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "lobbyOnly", "label": "Joining", "type": "enum", "default": "0",
      "options": [
        { "value": "0", "label": "By address or from a lobby" },
        { "value": "1", "label": "Only from a lobby" }
      ] },
    { "key": "difficulty", "label": "Difficulty", "type": "enum",
      "options": [ { "value": "Easy", "label": "Easy" }, { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Advanced" }, { "value": "Impossible", "label": "Expert" } ],
      "description": "Campaign and realism only." },
    { "key": "steamGroup", "label": "Steam group", "type": "string", "maxLength": 20, "pattern": "^[0-9]{1,20}$",
      "description": "The group's number (its ID on its Steam page): the server shows up for its members." },
    { "key": "steamGroupOnly", "label": "Steam group members only", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "tags", "label": "Server tags", "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_,-]{1,128}$",
      "description": "Comma-separated tags shown in the server browser." },
    { "key": "region", "label": "Region", "type": "enum",
      "options": [ { "value": "-1", "label": "None" }, { "value": "0", "label": "US East" }, { "value": "1", "label": "US West" }, { "value": "2", "label": "South America" },
                   { "value": "3", "label": "Europe" }, { "value": "4", "label": "Asia" }, { "value": "5", "label": "Australia" }, { "value": "6", "label": "Middle East" }, { "value": "7", "label": "Africa" }, { "value": "255", "label": "World" } ],
      "description": "Region shown in the server browser." },
    { "key": "searchKey", "label": "Lobby search key", "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Players can find the server in lobbies with this key." },
    { "key": "lan", "label": "LAN only", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Not listed on the internet and players are not authenticated." },
    { "key": "cheats", "label": "Cheats", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Players can use cheat commands." },
    { "key": "voice", "label": "Voice chat", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "visibleMaxPlayers", "label": "Slots shown in the browser", "type": "integer", "min": -1, "max": 32,
      "description": "-1: the real slots." },
    { "key": "pure", "label": "Pure server", "type": "enum",
      "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "Files must match, except the whitelist" }, { "value": "2", "label": "Files must come from Steam" } ] },
    { "key": "consistency", "label": "Check critical files", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "downloadUrl", "label": "Fast download URL", "type": "string", "maxLength": 200, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,190}$",
      "description": "Where players download custom content instead of the server." },
    { "key": "pausable", "label": "Players can pause", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ] }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 27015,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 222860 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 222860 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "srcds.exe",
      "arguments": [
        "-game", "left4dead2",
        "-console", "-condebug", "-nocrashdialog",
        "-ip", "{{port.game.ip}}",
        "-port", "{{port.game}}",
        "+map", "{{var.map}}",
        "+rcon_password", "{{rcon.password}}",
        "+sv_rcon_maxfailures", "5",
        "+sv_rcon_banpenalty", "30"
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "logfile+rcon",
        "logFile": "left4dead2/console.log",
        "rcon": { "protocol": "source", "port": "game" },
        "sensitiveCommandPrefixes": ["rcon_password", "sv_password"]
      }
    }
  },

  "configFiles": [
    { "path": "left4dead2/cfg/server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "hostname": "{{var.hostname}}", "sv_password": "{{var.password}}",
        "sv_allow_lobby_connect_only": "{{var.lobbyOnly}}",
        "z_difficulty": "{{var.difficulty}}",
        "sv_steamgroup": "{{var.steamGroup}}",
        "sv_steamgroup_exclusive": "{{var.steamGroupOnly}}",
        "sv_tags": "{{var.tags}}",
        "sv_region": "{{var.region}}",
        "sv_search_key": "{{var.searchKey}}",
        "sv_lan": "{{var.lan}}",
        "sv_cheats": "{{var.cheats}}",
        "sv_voiceenable": "{{var.voice}}",
        "sv_visiblemaxplayers": "{{var.visibleMaxPlayers}}",
        "sv_pure": "{{var.pure}}",
        "sv_consistency": "{{var.consistency}}",
        "sv_downloadurl": "{{var.downloadUrl}}",
        "sv_pausable": "{{var.pausable}}"
      },
      "keepIfEmpty": ["hostname", "z_difficulty", "sv_steamgroup", "sv_steamgroup_exclusive",
        "sv_tags", "sv_region", "sv_search_key", "sv_lan", "sv_cheats", "sv_voiceenable", "sv_visiblemaxplayers", "sv_pure", "sv_consistency", "sv_downloadurl", "sv_pausable"] }
  ],

  "query": { "protocol": "a2s", "port": "game" },
  "readiness": { "type": "rcon", "timeoutSeconds": 240 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "quit" } ],
    "timeoutSeconds": 30
  },

  "backup": {
    "include": ["left4dead2/cfg/**", "left4dead2/addons/**"],
    "exclude": ["**/*.log", "**/*.dmp", "left4dead2/addons/workshop/**"]
  },
  "commands": { "broadcast": "say {{message}}", "players": { "kick": "kick \"{{player}}\"", "spaces": true } }
}
