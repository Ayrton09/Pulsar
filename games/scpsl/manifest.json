{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "scpsl",
  "version": "1.4.2",
  "name": "SCP: Secret Laboratory",
  "description": "SCP: Secret Laboratory dedicated server run by its LocalAdmin, installed anonymously with SteamCMD (about 1 GB). Its configuration is kept in the server folder, in config/config (config_gameplay.txt starts as the game's own template), and its plugins (LabAPI, EXILED) in profile/AppData/Roaming; LocalAdmin keeps its own settings and logs in the profile of the account the server runs as.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 3, "minMemoryMb": 2048 },

  "variables": [
    { "key": "eula", "label": "SCP: Secret Laboratory EULA", "type": "enum", "required": true,
      "options": [ { "value": "accepted", "label": "I accept it" } ],
      "description": "The game's terms for servers: https://link.scpslgame.com/eula. Its server does not run without accepting them." },
    { "key": "serverName", "label": "Server name", "type": "string", "maxLength": 400, "pattern": "^[^\"\\\\]{1,400}$",
      "description": "As players see it in the server list. The game's rich text works: <color=#FF8800>…</color>, <b>…</b>, <i>…</i>, <size=60>…</size>. Leave it empty for the game's own name." },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 20, "min": 1, "max": 100 },
    { "key": "playerListTitle", "label": "Player list title", "type": "string", "maxLength": 400, "pattern": "^[^\"\\\\]{1,400}$",
      "description": "Shown above the player list. Empty: the server name." },
    { "key": "contactEmail", "label": "Contact email", "type": "string", "maxLength": 254, "pattern": "^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,185}\\.[A-Za-z]{2,24}$",
      "description": "Needed for the public server list: the game's staff writes to it to verify the server." },
    { "key": "tickrate", "label": "Tick rate", "type": "integer", "min": 20, "max": 120,
      "description": "Updates per second. 60 is the game's own; higher uses more CPU." },
    { "key": "friendlyFire", "label": "Friendly fire", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "friendlyFireMultiplier", "label": "Friendly fire damage", "type": "number", "min": 0, "max": 10,
      "description": "Share of the damage teammates take. 0.4 is the game's own." },
    { "key": "roundRestartTime", "label": "Next round after (s)", "type": "integer", "min": 1, "max": 120 },
    { "key": "lobbyWaitingTime", "label": "Lobby wait (s)", "type": "integer", "min": 5, "max": 120,
      "description": "Seconds the lobby waits for players before the round starts." },
    { "key": "lateJoinTime", "label": "Late join (s)", "type": "integer", "min": 0, "max": 600,
      "description": "Seconds after the round starts that joining players still spawn." },
    { "key": "afkTime", "label": "AFK kick after (s)", "type": "integer", "min": 0, "max": 3600,
      "description": "Seconds in the spawn without moving before a player is kicked. 0 turns it off." },
    { "key": "warheadTime", "label": "Warhead countdown (s)", "type": "integer", "min": 10, "max": 600 },
    { "key": "disableDecontamination", "label": "Turn off decontamination", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ],
      "description": "Light Containment Zone is never decontaminated." },
    { "key": "mapSeed", "label": "Map seed", "type": "integer", "min": -1, "max": 2147483647,
      "description": "The same seed gives the same facility. -1: a new one every round." },
    { "key": "whitelist", "label": "Only whitelisted players", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "hideFromList", "label": "Hide from the public list", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "serverInfoId", "label": "Server info Pastebin ID", "type": "string", "maxLength": 16, "pattern": "^[A-Za-z0-9]{1,16}$",
      "description": "Pastebin ID of the text shown in the server browser's info tab." },
    { "key": "ipBanning", "label": "IP bans", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Turn off if the server is behind a proxy or firewall." },
    { "key": "fastRestart", "label": "Fast round restart", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "fastRestartDelay", "label": "Fast restart delay (s)", "type": "number", "min": 0, "max": 60 },
    { "key": "intercomCooldown", "label": "Intercom cooldown (s)", "type": "integer", "min": 0, "max": 3600 },
    { "key": "intercomSpeech", "label": "Intercom speech time (s)", "type": "integer", "min": 1, "max": 600 },
    { "key": "warheadGates", "label": "Gates open during warhead countdown", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "warheadDoors", "label": "Doors open during warhead countdown", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "warheadLockZones", "label": "Lock checkpoints during warhead countdown", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "keepItems", "label": "Keep items after escaping", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "endOnOnePlayer", "label": "Round ends with one player left", "type": "enum", "options": [ { "value": "true", "label": "Yes" }, { "value": "false", "label": "No" } ] },
    { "key": "spawnProtect", "label": "Spawn protection", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "spawnProtectTime", "label": "Spawn protection (s)", "type": "number", "min": 0, "max": 60 },
    { "key": "mtfMinTime", "label": "MTF wave, earliest (s)", "type": "integer", "min": 30, "max": 3600 },
    { "key": "mtfMaxTime", "label": "MTF wave, latest (s)", "type": "integer", "min": 30, "max": 3600 },
    { "key": "mtfMaxAmount", "label": "MTF wave size", "type": "integer", "min": 1, "max": 100 },
    { "key": "ciMaxAmount", "label": "Chaos wave size", "type": "integer", "min": 1, "max": 100 }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 7777 }
  ],

  "install": { "steps": [
    { "type": "steamcmd", "appId": 996560 },
    { "type": "ensureDirectory", "path": "config/config" },
    { "type": "copyFileIfMissing", "from": "ConfigTemplates/config_gameplay.template.txt", "to": "config/config/config_gameplay.txt" }
  ] },
  "update": { "steps": [
    { "type": "steamcmd", "appId": 996560 },
    { "type": "ensureDirectory", "path": "config/config" },
    { "type": "copyFileIfMissing", "from": "ConfigTemplates/config_gameplay.template.txt", "to": "config/config/config_gameplay.txt" }
  ] },

  "runtime": {
    "windows-x64": {
      "executable": "LocalAdmin.exe",
      "arguments": [
        "{{port.game}}",
        "--acceptEULA",
        "--useDefault", "--noSetCursor", "--noTerminalTitle",
        "--",
        "-silent-crashes",
        "-appdatapath", "{{server.dir}}/config/",
        "-configpath", "{{server.dir}}/config/config/"
      ],
      "allowExtraArguments": false,
      "userProfile": "profile",
      "console": { "mode": "pty", "encoding": "utf-8" }
    }
  },

  "configFiles": [
    { "path": "config/config/config_gameplay.txt", "format": "colon", "mode": "patch",
      "set": {
        "server_name": "{{var.serverName}}",
        "max_players": "{{var.maxPlayers}}",
        "player_list_title": "{{var.playerListTitle}}",
        "contact_email": "{{var.contactEmail}}",
        "server_tickrate": "{{var.tickrate}}",
        "friendly_fire": "{{var.friendlyFire}}",
        "friendly_fire_multiplier": "{{var.friendlyFireMultiplier}}",
        "auto_round_restart_time": "{{var.roundRestartTime}}",
        "lobby_waiting_time": "{{var.lobbyWaitingTime}}",
        "late_join_time": "{{var.lateJoinTime}}",
        "afk_time": "{{var.afkTime}}",
        "warhead_tminus_start_duration": "{{var.warheadTime}}",
        "disable_decontamination": "{{var.disableDecontamination}}",
        "map_seed": "{{var.mapSeed}}",
        "enable_whitelist": "{{var.whitelist}}",
        "hide_from_public_list": "{{var.hideFromList}}",
        "serverinfo_pastebin_id": "{{var.serverInfoId}}",
        "ip_banning": "{{var.ipBanning}}",
        "enable_fast_round_restart": "{{var.fastRestart}}",
        "fast_round_restart_delay": "{{var.fastRestartDelay}}",
        "intercom_cooldown": "{{var.intercomCooldown}}",
        "intercom_max_speech_time": "{{var.intercomSpeech}}",
        "lock_gates_on_countdown": "{{var.warheadGates}}",
        "open_doors_on_countdown": "{{var.warheadDoors}}",
        "isolate_zones_on_countdown": "{{var.warheadLockZones}}",
        "keep_items_after_escaping": "{{var.keepItems}}",
        "end_round_on_one_player": "{{var.endOnOnePlayer}}",
        "spawn_protect_enabled": "{{var.spawnProtect}}",
        "spawn_protect_time": "{{var.spawnProtectTime}}",
        "minimum_MTF_time_to_spawn": "{{var.mtfMinTime}}",
        "maximum_MTF_time_to_spawn": "{{var.mtfMaxTime}}",
        "maximum_MTF_respawn_amount": "{{var.mtfMaxAmount}}",
        "maximum_CI_respawn_amount": "{{var.ciMaxAmount}}"
      },
      "keepIfEmpty": ["player_list_title", "contact_email", "server_tickrate", "friendly_fire", "friendly_fire_multiplier", "auto_round_restart_time", "lobby_waiting_time", "late_join_time", "afk_time", "warhead_tminus_start_duration", "disable_decontamination", "map_seed", "enable_whitelist",
        "hide_from_public_list", "serverinfo_pastebin_id", "ip_banning", "enable_fast_round_restart", "fast_round_restart_delay", "intercom_cooldown", "intercom_max_speech_time", "lock_gates_on_countdown", "open_doors_on_countdown", "isolate_zones_on_countdown", "keep_items_after_escaping", "end_round_on_one_player", "spawn_protect_enabled", "spawn_protect_time", "minimum_MTF_time_to_spawn", "maximum_MTF_time_to_spawn", "maximum_MTF_respawn_amount", "maximum_CI_respawn_amount"] }
  ],

  "readiness": { "type": "logPattern", "pattern": "Waiting for players\\.\\.\\.", "timeoutSeconds": 300 },

  "stop": {
    "steps": [ { "type": "consoleCommand", "command": "exit" }, { "type": "wait", "seconds": 20 } ],
    "timeoutSeconds": 45
  },

  "backup": {
    "include": ["config/**", "profile/AppData/Roaming/SCP Secret Laboratory/LabAPI/**", "profile/AppData/Roaming/EXILED/**"],
    "exclude": ["config/LocalAdminLogs/**", "config/ServerLogs/**", "config/internal/**", "profile/AppData/Roaming/EXILED/Logs/**"]
  },
  "addons": [
    { "key": "exiled", "name": "EXILED", "license": "CC-BY-SA-3.0", "url": "https://github.com/ExMod-Team/EXILED",
      "description": "The plugin framework most servers run, loaded by the game's LabAPI. Its plugins go in profile/AppData/Roaming/EXILED/Plugins, and LabAPI's own in profile/AppData/Roaming/SCP Secret Laboratory/LabAPI/plugins/global.",
      "source": { "type": "githubRelease", "repo": "ExMod-Team/EXILED", "asset": "^Exiled\\.tar\\.gz$" },
      "target": "profile/AppData/Roaming" }
  ]
}
