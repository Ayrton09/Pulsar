{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "ark-sa",
  "version": "1.1.0",
  "name": "ARK: Survival Ascended",
  "description": "ARK: Survival Ascended dedicated server, installed anonymously with SteamCMD (about 12 GB). Dedicated servers are for personal, non-commercial use unless you have a licence from its publisher; read this game's README.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 25, "minMemoryMb": 16384 },

  "variables": [
    { "key": "sessionName", "label": "Server name", "type": "string", "default": "Pulsar ARK", "maxLength": 63, "pattern": "^[^?\";\\\\]{1,63}$",
      "description": "As players see it in the server list." },
    { "key": "map", "label": "Map", "type": "string", "default": "TheIsland_WP", "maxLength": 64, "pattern": "^[A-Za-z0-9_]{1,64}$",
      "description": "The map's name with its _WP suffix: TheIsland_WP, ScorchedEarth_WP, TheCenter_WP, Aberration_WP, Extinction_WP…" },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 70, "min": 1, "max": 200 },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for an open server." },
    { "key": "mods", "label": "Mods", "type": "string", "default": "", "maxLength": 512, "pattern": "^([0-9]{1,10}(,[0-9]{1,10}){0,49})?$",
      "description": "CurseForge project ids, separated by commas (\"928548,929420\"). The server downloads and updates them itself when it starts." },
    { "key": "battleye", "label": "BattlEye anti-cheat", "type": "boolean", "default": false },
    { "key": "pve", "label": "PvE", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ],
      "description": "Players and their dinos cannot hurt each other." },
    { "key": "tamingSpeed", "label": "Taming speed", "type": "number", "min": 0.1, "max": 100,
      "description": "1 is the game's own; 3 tames three times as fast." },
    { "key": "harvestAmount", "label": "Harvest amount", "type": "number", "min": 0.1, "max": 100,
      "description": "Resources gathered per hit. 1 is the game's own." },
    { "key": "xp", "label": "Experience", "type": "number", "min": 0.1, "max": 100,
      "description": "Experience earned. 1 is the game's own." },
    { "key": "difficulty", "label": "Difficulty", "type": "number", "min": 1, "max": 10,
      "description": "Sets the highest wild dino level: 5 for level 150, 1 for level 30." },
    { "key": "dayCycleSpeed", "label": "Day cycle speed", "type": "number", "min": 0.1, "max": 100,
      "description": "How fast time passes. 1 is the game's own." },
    { "key": "dayTimeSpeed", "label": "Daytime speed", "type": "number", "min": 0.1, "max": 100,
      "description": "How fast the day passes, on top of the day cycle speed." },
    { "key": "nightTimeSpeed", "label": "Nighttime speed", "type": "number", "min": 0.1, "max": 100,
      "description": "How fast the night passes, on top of the day cycle speed." },
    { "key": "autoSave", "label": "Autosave every (min)", "type": "integer", "min": 1, "max": 1440 },
    { "key": "maxTamedDinos", "label": "Max tamed dinos", "type": "integer", "min": 100, "max": 20000,
      "description": "For the whole server." },
    { "key": "crosshair", "label": "Crosshair", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "mapPlayerLocation", "label": "Show players on the map", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "thirdPerson", "label": "Third-person view", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "eggHatchSpeed", "label": "Egg hatch speed", "type": "number", "min": 0.1, "max": 100,
      "description": "Higher hatches eggs faster. 1 is the game's own." },
    { "key": "matingInterval", "label": "Mating interval", "type": "number", "min": 0.01, "max": 100,
      "description": "Time between matings: lower is sooner. 1 is the game's own." },
    { "key": "babyMatureSpeed", "label": "Baby maturation speed", "type": "number", "min": 0.1, "max": 100,
      "description": "Higher grows babies faster. 1 is the game's own." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 7777,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 2430930 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 2430930 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "ShooterGame/Binaries/Win64/ArkAscendedServer.exe",
      "workingDirectory": "ShooterGame/Binaries/Win64",
      "arguments": [
        "{{var.map}}?listen?SessionName={{var.sessionName}}?Port={{port.game}}",
        "-WinLiveMaxPlayers={{var.maxPlayers}}",
        { "if": "var.mods", "then": ["-mods={{var.mods}}"] },
        { "if": "var.battleye", "then": [], "else": ["-NoBattlEye"] },
        "-servergamelog"
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "logfile+rcon",
        "logFile": "ShooterGame/Saved/Logs/ShooterGame.log",
        "rcon": { "protocol": "source", "port": "game" },
        "sensitiveCommandPrefixes": ["ServerAdminPassword", "SetServerPassword", "ServerPassword", "SpectatorPassword"]
      }
    }
  },

  "configFiles": [
    { "path": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini", "format": "unreal-ini", "mode": "patch",
      "section": "ServerSettings",
      "set": {
        "ServerAdminPassword": "{{rcon.password}}",
        "RCONEnabled": "True",
        "RCONPort": "{{port.game}}",
        "ServerPassword": "{{var.password}}",
        "ServerPVE": "{{var.pve}}",
        "TamingSpeedMultiplier": "{{var.tamingSpeed}}",
        "HarvestAmountMultiplier": "{{var.harvestAmount}}",
        "XPMultiplier": "{{var.xp}}",
        "OverrideOfficialDifficulty": "{{var.difficulty}}",
        "DayCycleSpeedScale": "{{var.dayCycleSpeed}}",
        "DayTimeSpeedScale": "{{var.dayTimeSpeed}}",
        "NightTimeSpeedScale": "{{var.nightTimeSpeed}}",
        "AutoSavePeriodMinutes": "{{var.autoSave}}",
        "MaxTamedDinos": "{{var.maxTamedDinos}}",
        "ServerCrosshair": "{{var.crosshair}}",
        "ShowMapPlayerLocation": "{{var.mapPlayerLocation}}",
        "AllowThirdPersonPlayer": "{{var.thirdPerson}}"
      },
      "keepIfEmpty": ["ServerPVE", "TamingSpeedMultiplier", "HarvestAmountMultiplier", "XPMultiplier", "OverrideOfficialDifficulty", "DayCycleSpeedScale", "DayTimeSpeedScale", "NightTimeSpeedScale", "AutoSavePeriodMinutes", "MaxTamedDinos", "ServerCrosshair", "ShowMapPlayerLocation", "AllowThirdPersonPlayer"] },
    { "path": "ShooterGame/Saved/Config/WindowsServer/Game.ini", "format": "unreal-ini", "mode": "patch",
      "section": "/script/shootergame.shootergamemode",
      "set": {
        "EggHatchSpeedMultiplier": "{{var.eggHatchSpeed}}",
        "MatingIntervalMultiplier": "{{var.matingInterval}}",
        "BabyMatureSpeedMultiplier": "{{var.babyMatureSpeed}}"
      },
      "keepIfEmpty": ["EggHatchSpeedMultiplier", "MatingIntervalMultiplier", "BabyMatureSpeedMultiplier"] }
  ],

  "readiness": { "type": "logPattern", "pattern": "is now advertising for join", "timeoutSeconds": 1200 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "SaveWorld" }, { "type": "wait", "seconds": 5 }, { "type": "rconCommand", "command": "DoExit" } ],
    "timeoutSeconds": 180
  },

  "backup": {
    "include": ["ShooterGame/Saved/SavedArks/**", "ShooterGame/Saved/Config/WindowsServer/*.ini"],
    "exclude": ["**/*.log"],
    "save": { "commands": ["SaveWorld"], "waitSeconds": 10 }
  }
}
