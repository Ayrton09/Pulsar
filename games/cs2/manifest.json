{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "cs2",
  "version": "1.3.0",
  "name": "Counter-Strike 2",
  "description": "Counter-Strike 2 dedicated server, installed anonymously with SteamCMD (about 75 GB).",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 85, "minMemoryMb": 4096 },

  "variables": [
    { "key": "hostname", "label": "Server name", "type": "string", "default": "Pulsar CS2", "maxLength": 64, "pattern": "^[^\";]{1,64}$" },
    { "key": "map", "label": "Starting map", "type": "string", "default": "de_dust2", "maxLength": 64, "pattern": "^[A-Za-z0-9_]{1,64}$" },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 10, "min": 2, "max": 64 },
    { "key": "gameMode", "label": "Game mode", "type": "enum", "default": "competitive",
      "options": [
        { "value": "casual", "label": "Casual", "map": { "gameType": "0", "gameMode": "0" } },
        { "value": "competitive", "label": "Competitive", "map": { "gameType": "0", "gameMode": "1" } },
        { "value": "wingman", "label": "Wingman", "map": { "gameType": "0", "gameMode": "2" } },
        { "value": "armsrace", "label": "Arms Race", "map": { "gameType": "1", "gameMode": "0" } },
        { "value": "deathmatch", "label": "Deathmatch", "map": { "gameType": "1", "gameMode": "2" } }
      ] },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "gslt", "label": "Game Server Login Token", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Fa-f0-9]{32}$",
      "description": "Needed for players outside your network to find and join the server. Create one at https://steamcommunity.com/dev/managegameservers (app 730)." },
    { "key": "friendlyFire", "label": "Friendly fire", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Teammates can hurt each other." },
    { "key": "maxRounds", "label": "Max rounds", "type": "integer", "min": 0, "max": 100,
      "description": "Rounds a match lasts. 0: no limit." },
    { "key": "roundTime", "label": "Round time (min)", "type": "number", "min": 0.5, "max": 60,
      "description": "Minutes a round lasts, on every kind of map." },
    { "key": "freezeTime", "label": "Freeze time (s)", "type": "integer", "min": 0, "max": 60,
      "description": "Seconds players cannot move at the start of a round." },
    { "key": "buyTime", "label": "Buy time (s)", "type": "integer", "min": 0, "max": 600,
      "description": "Seconds players can buy at the start of a round." },
    { "key": "startMoney", "label": "Start money", "type": "integer", "min": 0, "max": 16000 },
    { "key": "warmupTime", "label": "Warmup (s)", "type": "integer", "min": 0, "max": 3600,
      "description": "Seconds of warmup before a match." },
    { "key": "autoTeamBalance", "label": "Auto team balance", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "limitTeams", "label": "Max team size difference", "type": "integer", "min": 0, "max": 30,
      "description": "How many more players one team may have than the other. 0: no limit." },
    { "key": "allTalk", "label": "All talk", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Both teams hear each other on voice chat." },
    { "key": "bots", "label": "Bots", "type": "integer", "min": 0, "max": 64,
      "description": "How many bots fill the server." },
    { "key": "tags", "label": "Server tags", "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_,-]{1,128}$",
      "description": "Comma-separated tags shown in the server browser." },
    { "key": "lan", "label": "LAN only", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Not listed on the internet and players are not authenticated." },
    { "key": "cheats", "label": "Cheats", "type": "enum", "options": [ { "value": "0", "label": "Off" }, { "value": "1", "label": "On" } ],
      "description": "Players can use cheat commands." },
    { "key": "voice", "label": "Voice chat", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] },
    { "key": "workshopMap", "label": "Workshop map ID", "type": "string", "maxLength": 20, "pattern": "^[0-9]{1,20}$",
      "description": "Starts on this Steam Workshop map instead of the starting map." },
    { "key": "workshopCollection", "label": "Workshop collection ID", "type": "string", "maxLength": 20, "pattern": "^[0-9]{1,20}$",
      "description": "Hosts the maps of this Steam Workshop collection." },
    { "key": "mapGroup", "label": "Map group", "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_]{1,64}$",
      "description": "Map group from gamemodes_server.txt that sets the map rotation." },
    { "key": "overtime", "label": "Overtime", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Play overtime when the score is tied after the last round." },
    { "key": "overtimeRounds", "label": "Overtime rounds", "type": "integer", "min": 2, "max": 30 },
    { "key": "halftime", "label": "Halftime", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "Teams swap sides in the middle of the match." },
    { "key": "matchClinch", "label": "End when clinched", "type": "enum", "options": [ { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ],
      "description": "The match ends as soon as one team cannot be caught." },
    { "key": "c4Timer", "label": "C4 timer (s)", "type": "integer", "min": 10, "max": 90 },
    { "key": "botDifficulty", "label": "Bot difficulty", "type": "enum",
      "options": [ { "value": "0", "label": "Easy" }, { "value": "1", "label": "Normal" }, { "value": "2", "label": "Hard" }, { "value": "3", "label": "Expert" } ] }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 27015,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." },
    { "name": "tv", "label": "CSTV", "protocols": ["udp"], "default": 27020, "required": false, "description": "Assign it to enable CSTV." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 730 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 730 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "game/bin/win64/cs2.exe",
      "workingDirectory": "game/bin/win64",
      "arguments": [
        "-dedicated", "-condebug", "-usercon",
        "-ip", "{{port.game.ip}}",
        "-port", "{{port.game}}",
        { "if": "port.tv", "then": ["+tv_enable", "1", "+tv_port", "{{port.tv}}"] },
        "-maxplayers", "{{var.maxPlayers}}",
        "+game_type", "{{var.gameMode.gameType}}",
        "+game_mode", "{{var.gameMode.gameMode}}",
        { "if": "var.workshopMap", "then": ["+host_workshop_map", "{{var.workshopMap}}"], "else": ["+map", "{{var.map}}"] },
        { "if": "var.workshopCollection", "then": ["+host_workshop_collection", "{{var.workshopCollection}}"] },
        { "if": "var.mapGroup", "then": ["+mapgroup", "{{var.mapGroup}}"] },
        "+rcon_password", "{{rcon.password}}",
        { "if": "var.gslt", "then": ["+sv_setsteamaccount", "{{var.gslt}}"] }
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "logfile+rcon",
        "logFile": "game/csgo/console.log",
        "rcon": { "protocol": "source", "port": "game", "logsCommands": true },
        "sensitiveCommandPrefixes": ["rcon_password", "sv_password", "sv_setsteamaccount"]
      }
    }
  },

  "configFiles": [
    { "path": "game/csgo/cfg/server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "hostname": "{{var.hostname}}", "sv_password": "{{var.password}}",
        "sv_tags": "{{var.tags}}", "sv_lan": "{{var.lan}}", "sv_cheats": "{{var.cheats}}", "sv_voiceenable": "{{var.voice}}"
      },
      "keepIfEmpty": ["sv_tags", "sv_lan", "sv_cheats", "sv_voiceenable"] },
    { "path": "game/csgo/cfg/gamemode_casual_server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_roundtime_defuse": "{{var.roundTime}}",
        "mp_roundtime_hostage": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_buytime": "{{var.buyTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_warmuptime": "{{var.warmupTime}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "mp_overtime_enable": "{{var.overtime}}",
        "mp_overtime_maxrounds": "{{var.overtimeRounds}}",
        "mp_halftime": "{{var.halftime}}",
        "mp_match_can_clinch": "{{var.matchClinch}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "bot_difficulty": "{{var.botDifficulty}}"
      },
      "keepIfEmpty": ["mp_friendlyfire", "mp_maxrounds", "mp_roundtime", "mp_roundtime_defuse", "mp_roundtime_hostage", "mp_freezetime", "mp_buytime", "mp_startmoney", "mp_warmuptime", "mp_autoteambalance", "mp_limitteams", "sv_alltalk", "bot_quota", "mp_overtime_enable", "mp_overtime_maxrounds", "mp_halftime", "mp_match_can_clinch", "mp_c4timer", "bot_difficulty"] },
    { "path": "game/csgo/cfg/gamemode_competitive_server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_roundtime_defuse": "{{var.roundTime}}",
        "mp_roundtime_hostage": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_buytime": "{{var.buyTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_warmuptime": "{{var.warmupTime}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "mp_overtime_enable": "{{var.overtime}}",
        "mp_overtime_maxrounds": "{{var.overtimeRounds}}",
        "mp_halftime": "{{var.halftime}}",
        "mp_match_can_clinch": "{{var.matchClinch}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "bot_difficulty": "{{var.botDifficulty}}"
      },
      "keepIfEmpty": ["mp_friendlyfire", "mp_maxrounds", "mp_roundtime", "mp_roundtime_defuse", "mp_roundtime_hostage", "mp_freezetime", "mp_buytime", "mp_startmoney", "mp_warmuptime", "mp_autoteambalance", "mp_limitteams", "sv_alltalk", "bot_quota", "mp_overtime_enable", "mp_overtime_maxrounds", "mp_halftime", "mp_match_can_clinch", "mp_c4timer", "bot_difficulty"] },
    { "path": "game/csgo/cfg/gamemode_competitive2v2_server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_roundtime_defuse": "{{var.roundTime}}",
        "mp_roundtime_hostage": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_buytime": "{{var.buyTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_warmuptime": "{{var.warmupTime}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "mp_overtime_enable": "{{var.overtime}}",
        "mp_overtime_maxrounds": "{{var.overtimeRounds}}",
        "mp_halftime": "{{var.halftime}}",
        "mp_match_can_clinch": "{{var.matchClinch}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "bot_difficulty": "{{var.botDifficulty}}"
      },
      "keepIfEmpty": ["mp_friendlyfire", "mp_maxrounds", "mp_roundtime", "mp_roundtime_defuse", "mp_roundtime_hostage", "mp_freezetime", "mp_buytime", "mp_startmoney", "mp_warmuptime", "mp_autoteambalance", "mp_limitteams", "sv_alltalk", "bot_quota", "mp_overtime_enable", "mp_overtime_maxrounds", "mp_halftime", "mp_match_can_clinch", "mp_c4timer", "bot_difficulty"] },
    { "path": "game/csgo/cfg/gamemode_armsrace_server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_roundtime_defuse": "{{var.roundTime}}",
        "mp_roundtime_hostage": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_buytime": "{{var.buyTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_warmuptime": "{{var.warmupTime}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "mp_overtime_enable": "{{var.overtime}}",
        "mp_overtime_maxrounds": "{{var.overtimeRounds}}",
        "mp_halftime": "{{var.halftime}}",
        "mp_match_can_clinch": "{{var.matchClinch}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "bot_difficulty": "{{var.botDifficulty}}"
      },
      "keepIfEmpty": ["mp_friendlyfire", "mp_maxrounds", "mp_roundtime", "mp_roundtime_defuse", "mp_roundtime_hostage", "mp_freezetime", "mp_buytime", "mp_startmoney", "mp_warmuptime", "mp_autoteambalance", "mp_limitteams", "sv_alltalk", "bot_quota", "mp_overtime_enable", "mp_overtime_maxrounds", "mp_halftime", "mp_match_can_clinch", "mp_c4timer", "bot_difficulty"] },
    { "path": "game/csgo/cfg/gamemode_deathmatch_server.cfg", "format": "source-cfg", "mode": "patch",
      "set": {
        "mp_friendlyfire": "{{var.friendlyFire}}",
        "mp_maxrounds": "{{var.maxRounds}}",
        "mp_roundtime": "{{var.roundTime}}",
        "mp_roundtime_defuse": "{{var.roundTime}}",
        "mp_roundtime_hostage": "{{var.roundTime}}",
        "mp_freezetime": "{{var.freezeTime}}",
        "mp_buytime": "{{var.buyTime}}",
        "mp_startmoney": "{{var.startMoney}}",
        "mp_warmuptime": "{{var.warmupTime}}",
        "mp_autoteambalance": "{{var.autoTeamBalance}}",
        "mp_limitteams": "{{var.limitTeams}}",
        "sv_alltalk": "{{var.allTalk}}",
        "bot_quota": "{{var.bots}}",
        "mp_overtime_enable": "{{var.overtime}}",
        "mp_overtime_maxrounds": "{{var.overtimeRounds}}",
        "mp_halftime": "{{var.halftime}}",
        "mp_match_can_clinch": "{{var.matchClinch}}",
        "mp_c4timer": "{{var.c4Timer}}",
        "bot_difficulty": "{{var.botDifficulty}}"
      },
      "keepIfEmpty": ["mp_friendlyfire", "mp_maxrounds", "mp_roundtime", "mp_roundtime_defuse", "mp_roundtime_hostage", "mp_freezetime", "mp_buytime", "mp_startmoney", "mp_warmuptime", "mp_autoteambalance", "mp_limitteams", "sv_alltalk", "bot_quota", "mp_overtime_enable", "mp_overtime_maxrounds", "mp_halftime", "mp_match_can_clinch", "mp_c4timer", "bot_difficulty"] }
  ],

  "query": { "protocol": "a2s", "port": "game" },
  "readiness": { "type": "rcon", "timeoutSeconds": 300 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "quit" } ],
    "timeoutSeconds": 30
  },

  "backup": {
    "include": ["game/csgo/cfg/**", "game/csgo/addons/**", "game/csgo/gameinfo.gi", "game/csgo_addons/**"],
    "exclude": ["**/*.log", "**/*.dmp"]
  },

  "addons": [
    { "key": "metamod", "name": "Metamod:Source", "license": "zlib", "url": "https://www.metamodsource.net/",
      "description": "Plugin loader the other server plugins run on. Its development builds are the only ones for Counter-Strike 2.",
      "source": { "type": "githubRelease", "repo": "alliedmodders/metamod-source", "asset": "^mmsource-2\\.0\\.0-git[0-9]+-windows\\.zip$", "prerelease": true },
      "target": "game/csgo",
      "lineEdits": [ { "path": "game/csgo/gameinfo.gi", "after": "Game_LowViolence csgo_lv", "line": "Game\tcsgo/addons/metamod" } ] },
    { "key": "counterstrikesharp", "name": "CounterStrikeSharp", "license": "GPL-3.0", "url": "https://docs.cssharp.dev/",
      "description": "Server plugins written in C#, with the .NET runtime they need. Plugins go in game/csgo/addons/counterstrikesharp/plugins.",
      "source": { "type": "githubRelease", "repo": "roflmuffin/CounterStrikeSharp", "asset": "^counterstrikesharp-with-runtime-windows-.*\\.zip$" },
      "target": "game/csgo",
      "requires": ["metamod"] }
  ],
  "commands": { "broadcast": "say {{message}}" }
}
