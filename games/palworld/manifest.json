{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "palworld",
  "version": "1.3.2",
  "name": "Palworld",
  "description": "Palworld dedicated server, installed anonymously with SteamCMD (about 4 GB). Pulsar talks to it over RCON; other world settings can be added to PalWorldSettings.ini by hand.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 10, "minMemoryMb": 8192 },

  "variables": [
    { "key": "name", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^[^\"\\\\]{1,64}$", "description": "Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "description", "label": "Description", "type": "string", "default": "", "maxLength": 200, "pattern": "^[^\"\\\\]{0,200}$" },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[^\"\\\\ ]{1,32}$",
      "description": "Leave it empty for an open server." },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 32, "min": 1, "max": 32 },
    { "key": "community", "label": "List it as a community server", "type": "boolean", "default": false },
    { "key": "expRate", "label": "Experience", "type": "number", "min": 0.1, "max": 20,
      "description": "1 is the game's own." },
    { "key": "captureRate", "label": "Capture rate", "type": "number", "min": 0.5, "max": 2,
      "description": "Higher catches Pals more easily. 1 is the game's own." },
    { "key": "spawnRate", "label": "Pal spawn rate", "type": "number", "min": 0.5, "max": 3,
      "description": "How many Pals appear. Higher uses more CPU. 1 is the game's own." },
    { "key": "gatheringRate", "label": "Gathering rate", "type": "number", "min": 0.5, "max": 3,
      "description": "Items from trees, rocks and the like. 1 is the game's own." },
    { "key": "enemyDropRate", "label": "Enemy drops", "type": "number", "min": 0.5, "max": 3,
      "description": "Items enemies drop. 1 is the game's own." },
    { "key": "workSpeed", "label": "Work speed", "type": "number", "min": 0.1, "max": 20,
      "description": "How fast Pals work at bases. 1 is the game's own." },
    { "key": "dayTimeSpeed", "label": "Daytime speed", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "nightTimeSpeed", "label": "Nighttime speed", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "eggHatchHours", "label": "Egg hatching time (h)", "type": "number", "min": 0, "max": 240,
      "description": "For the largest eggs; smaller ones take less." },
    { "key": "pvp", "label": "PvP", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ],
      "description": "Players can hurt each other." },
    { "key": "fastTravel", "label": "Fast travel", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "basesPerGuild", "label": "Bases per guild", "type": "integer", "min": 1, "max": 10 },
    { "key": "workersPerBase", "label": "Pals working per base", "type": "integer", "min": 1, "max": 50 },
    { "key": "guildSize", "label": "Players per guild", "type": "integer", "min": 1, "max": 100 },
    { "key": "autoSave", "label": "Autosave every (s)", "type": "number", "min": 5, "max": 3600,
      "description": "Seconds between world saves. 30 is the game's own." },
    { "key": "pvpDamage", "label": "Player-to-player damage", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "friendlyFire", "label": "Friendly fire", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "invaders", "label": "Base raids (invaders)", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ],
      "description": "Enemies attack player bases." },
    { "key": "hardcore", "label": "Hardcore", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ],
      "description": "Players cannot respawn after dying." },
    { "key": "palLost", "label": "Pals lost on death", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ],
      "description": "Pals that die are gone for good." },
    { "key": "palDamageAttack", "label": "Pal damage dealt", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "palDamageDefense", "label": "Pal damage taken", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "playerDamageAttack", "label": "Player damage dealt", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "playerDamageDefense", "label": "Player damage taken", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "playerHunger", "label": "Player hunger rate", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "playerStamina", "label": "Player stamina use", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "palHunger", "label": "Pal hunger rate", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "palStamina", "label": "Pal stamina use", "type": "number", "min": 0.1, "max": 5,
      "description": "1 is the game's own." },
    { "key": "buildDecay", "label": "Structure decay", "type": "number", "min": 0, "max": 10,
      "description": "0 stops structures from decaying. 1 is the game's own." },
    { "key": "itemWeight", "label": "Item weight", "type": "number", "min": 0, "max": 10,
      "description": "1 is the game's own." },
    { "key": "equipDurability", "label": "Equipment wear", "type": "number", "min": 0, "max": 10,
      "description": "0 means equipment never breaks. 1 is the game's own." },
    { "key": "baseCamps", "label": "Bases on the server", "type": "integer", "min": 1, "max": 1000,
      "description": "Most bases the whole server may have." },
    { "key": "buildingLimit", "label": "Buildings per player", "type": "integer", "min": 0, "max": 100000,
      "description": "0 means no limit." },
    { "key": "supplyDropMinutes", "label": "Supply drop every (min)", "type": "integer", "min": 1, "max": 1440 },
    { "key": "respawnSeconds", "label": "Respawn delay (s)", "type": "number", "min": 0, "max": 3600 },
    { "key": "backups", "label": "World backups", "type": "enum", "options": [ { "value": "True", "label": "On" }, { "value": "False", "label": "Off" } ],
      "description": "The game keeps its own backups of the world in the save folder." },
    { "key": "showPlayerList", "label": "Player list in the menu", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "allowClientMods", "label": "Players with mods", "type": "enum", "options": [ { "value": "True", "label": "Allowed" }, { "value": "False", "label": "Blocked" } ],
      "description": "Whether players using client mods may join." },
    { "key": "publicIp", "label": "Public IP", "type": "string", "maxLength": 45, "pattern": "^[0-9.]{7,15}$",
      "description": "For community servers behind NAT: the address players see." },
    { "key": "deathPenalty", "label": "Death penalty", "type": "enum",
      "options": [
        { "value": "None", "label": "Lose nothing" }, { "value": "Item", "label": "Lose items, not equipment" },
        { "value": "ItemAndEquipment", "label": "Lose items and equipment" }, { "value": "All", "label": "Lose items, equipment and Pals" }
      ],
      "description": "What players drop when they die." },
    { "key": "randomizer", "label": "Pal randomizer", "type": "enum",
      "options": [ { "value": "None", "label": "Off" }, { "value": "Region", "label": "By region" }, { "value": "All", "label": "Everywhere" } ],
      "description": "Wild Pals appear at random instead of where they live. Set it before the world is created." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 8211,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." },
    { "name": "query", "label": "Steam query", "protocols": ["udp"], "default": 27015 }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 2394010 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 2394010 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "Pal/Binaries/Win64/PalServer-Win64-Shipping-Cmd.exe",
      "workingDirectory": "Pal/Binaries/Win64",
      "arguments": [
        "Pal",
        "-port={{port.game}}",
        "-QueryPort={{port.query}}",
        "-players={{var.maxPlayers}}",
        "-logformat=text",
        { "if": "var.community", "then": ["-publiclobby"] }
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "pty",
        "encoding": "utf-8",
        "rcon": { "protocol": "source", "port": "game" },
        "sensitiveCommandPrefixes": ["AdminPassword"]
      }
    }
  },

  "configFiles": [
    { "path": "Pal/Saved/Config/WindowsServer/PalWorldSettings.ini", "format": "unreal-ini", "mode": "patch",
      "section": "/Script/Pal.PalGameWorldSettings", "struct": "OptionSettings",
      "set": {
        "ServerName": "{{var.name}}",
        "ServerDescription": "{{var.description}}",
        "ServerPassword": "{{var.password}}",
        "ServerPlayerMaxNum": "{{var.maxPlayers}}",
        "PublicPort": "{{port.game}}",
        "AdminPassword": "{{rcon.password}}",
        "RCONEnabled": "True",
        "RCONPort": "{{port.game}}",
        "ExpRate": "{{var.expRate}}",
        "PalCaptureRate": "{{var.captureRate}}",
        "PalSpawnNumRate": "{{var.spawnRate}}",
        "CollectionDropRate": "{{var.gatheringRate}}",
        "EnemyDropItemRate": "{{var.enemyDropRate}}",
        "WorkSpeedRate": "{{var.workSpeed}}",
        "DayTimeSpeedRate": "{{var.dayTimeSpeed}}",
        "NightTimeSpeedRate": "{{var.nightTimeSpeed}}",
        "PalEggDefaultHatchingTime": "{{var.eggHatchHours}}",
        "bIsPvP": "{{var.pvp}}",
        "bEnableFastTravel": "{{var.fastTravel}}",
        "BaseCampMaxNumInGuild": "{{var.basesPerGuild}}",
        "BaseCampWorkerMaxNum": "{{var.workersPerBase}}",
        "GuildPlayerMaxNum": "{{var.guildSize}}",
        "AutoSaveSpan": "{{var.autoSave}}",
        "DeathPenalty": "{{var.deathPenalty}}",
        "RandomizerType": "{{var.randomizer}}",
        "bEnablePlayerToPlayerDamage": "{{var.pvpDamage}}",
        "bEnableFriendlyFire": "{{var.friendlyFire}}",
        "bEnableInvaderEnemy": "{{var.invaders}}",
        "bHardcore": "{{var.hardcore}}",
        "bPalLost": "{{var.palLost}}",
        "PalDamageRateAttack": "{{var.palDamageAttack}}",
        "PalDamageRateDefense": "{{var.palDamageDefense}}",
        "PlayerDamageRateAttack": "{{var.playerDamageAttack}}",
        "PlayerDamageRateDefense": "{{var.playerDamageDefense}}",
        "PlayerStomachDecreaceRate": "{{var.playerHunger}}",
        "PlayerStaminaDecreaceRate": "{{var.playerStamina}}",
        "PalStomachDecreaceRate": "{{var.palHunger}}",
        "PalStaminaDecreaceRate": "{{var.palStamina}}",
        "BuildObjectDeteriorationDamageRate": "{{var.buildDecay}}",
        "ItemWeightRate": "{{var.itemWeight}}",
        "EquipmentDurabilityDamageRate": "{{var.equipDurability}}",
        "BaseCampMaxNum": "{{var.baseCamps}}",
        "MaxBuildingLimitNum": "{{var.buildingLimit}}",
        "SupplyDropSpan": "{{var.supplyDropMinutes}}",
        "BlockRespawnTime": "{{var.respawnSeconds}}",
        "bIsUseBackupSaveData": "{{var.backups}}",
        "bShowPlayerList": "{{var.showPlayerList}}",
        "bAllowClientMod": "{{var.allowClientMods}}",
        "PublicIP": "{{var.publicIp}}"
      },
      "keepIfEmpty": ["ServerName", "DeathPenalty", "RandomizerType", "ExpRate", "PalCaptureRate", "PalSpawnNumRate", "CollectionDropRate", "EnemyDropItemRate", "WorkSpeedRate", "DayTimeSpeedRate", "NightTimeSpeedRate", "PalEggDefaultHatchingTime", "bIsPvP", "bEnableFastTravel", "BaseCampMaxNumInGuild", "BaseCampWorkerMaxNum", "GuildPlayerMaxNum", "AutoSaveSpan", "bEnablePlayerToPlayerDamage", "bEnableFriendlyFire", "bEnableInvaderEnemy", "bHardcore", "bPalLost", "PalDamageRateAttack", "PalDamageRateDefense", "PlayerDamageRateAttack", "PlayerDamageRateDefense", "PlayerStomachDecreaceRate", "PlayerStaminaDecreaceRate", "PalStomachDecreaceRate", "PalStaminaDecreaceRate", "BuildObjectDeteriorationDamageRate", "ItemWeightRate", "EquipmentDurabilityDamageRate", "BaseCampMaxNum", "MaxBuildingLimitNum", "SupplyDropSpan", "BlockRespawnTime", "bIsUseBackupSaveData", "bShowPlayerList", "bAllowClientMod", "PublicIP"] }
  ],

  "readiness": { "type": "rcon", "timeoutSeconds": 600 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "Save" }, { "type": "rconCommand", "command": "Shutdown 1 Pulsar" } ],
    "timeoutSeconds": 60
  },

  "backup": {
    "include": ["Pal/Saved/SaveGames/**", "Pal/Saved/Config/WindowsServer/PalWorldSettings.ini"],
    "save": { "commands": ["Save"], "waitSeconds": 5 }
  },
  "commands": { "broadcast": "Broadcast {{message}}", "messageSpaces": "_" }
}
