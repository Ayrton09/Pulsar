{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "rust",
  "version": "1.3.0",
  "name": "Rust",
  "description": "Rust dedicated server, installed anonymously with SteamCMD (about 6 GB). Generating a new map takes several minutes and a lot of memory.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 15, "minMemoryMb": 8192 },

  "variables": [
    { "key": "hostname", "label": "Server name", "type": "string", "default": "Pulsar Rust", "maxLength": 64, "pattern": "^[^\";]{1,64}$" },
    { "key": "description", "label": "Description", "type": "string", "default": "", "maxLength": 200, "pattern": "^[^\";]{0,200}$" },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 50, "min": 1, "max": 500 },
    { "key": "worldSize", "label": "Map size", "type": "integer", "default": 3000, "min": 1000, "max": 6000,
      "description": "In meters per side. Bigger maps take longer to generate and need more memory." },
    { "key": "seed", "label": "Map seed", "type": "integer", "default": 12345, "min": 0, "max": 2147483647,
      "description": "The same seed and size make the same map." },
    { "key": "pve", "label": "PvE", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ],
      "description": "Players cannot hurt each other." },
    { "key": "globalChat", "label": "Global chat", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ] },
    { "key": "saveInterval", "label": "Autosave every (s)", "type": "integer", "min": 60, "max": 3600 },
    { "key": "decayScale", "label": "Decay speed", "type": "number", "min": 0, "max": 10,
      "description": "1 is the game's own; 0 turns decay off." },
    { "key": "upkeep", "label": "Upkeep", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ],
      "description": "Bases cost resources to keep up." },
    { "key": "stability", "label": "Building stability", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ] },
    { "key": "secure", "label": "Easy Anti-Cheat", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ],
      "description": "Off, players with cheats can join and the server is not listed as secure." },
    { "key": "instantCraft", "label": "Instant crafting", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ] },
    { "key": "airdropMinPlayers", "label": "Players for airdrops", "type": "integer", "min": 0, "max": 500,
      "description": "Airdrops come only with this many players online." },
    { "key": "tags", "label": "Server list tags", "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]{1,24}(,[a-z0-9]{1,24}){0,9}$",
      "description": "Comma-separated, such as monthly,vanilla,eu." },
    { "key": "url", "label": "Website", "type": "string", "maxLength": 200, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,200}$" },
    { "key": "headerImage", "label": "Header image URL", "type": "string", "maxLength": 200, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,200}$",
      "description": "A 512 × 256 JPG shown in the server browser." },
    { "key": "level", "label": "Map type", "type": "enum", "default": "procedural",
      "options": [ { "value": "procedural", "label": "Procedural", "map": { "name": "Procedural Map" } }, { "value": "barren", "label": "Barren", "map": { "name": "Barren" } },
                   { "value": "hapis", "label": "Hapis Island", "map": { "name": "HapisIsland" } }, { "value": "savas", "label": "Savas Island", "map": { "name": "SavasIsland" } } ],
      "description": "Procedural maps use the seed and size above." },
    { "key": "gamemode", "label": "Game mode", "type": "enum",
      "options": [ { "value": "vanilla", "label": "Vanilla" }, { "value": "softcore", "label": "Softcore" }, { "value": "hardcore", "label": "Hardcore" },
                   { "value": "primitive", "label": "Primitive" }, { "value": "weapontest", "label": "Weapon test" } ] },
    { "key": "tickRate", "label": "Tick rate", "type": "integer", "min": 15, "max": 100,
      "description": "Server updates per second. The game's default is 30; more costs CPU." },
    { "key": "salt", "label": "Map salt", "type": "integer", "min": 0, "max": 2147483647,
      "description": "With the seed and size it recreates a known map." },
    { "key": "levelUrl", "label": "Custom map URL", "type": "string", "maxLength": 255, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,240}$",
      "description": "Direct download link of a map file. Replaces the generated map." },
    { "key": "maxTeamSize", "label": "Max team size", "type": "integer", "min": 1, "max": 50,
      "description": "Players in a team. 1: solo only." },
    { "key": "radiation", "label": "Radiation", "type": "enum", "options": [ { "value": "on", "label": "On", "map": { "value": "true" } }, { "value": "off", "label": "Off", "map": { "value": "false" } } ] },
    { "key": "upkeepPeriod", "label": "Upkeep period (min)", "type": "integer", "min": 60, "max": 10080,
      "description": "Minutes over which a base's upkeep cost is spread." },
    { "key": "saveBackups", "label": "Save backups kept", "type": "integer", "min": 1, "max": 50,
      "description": "How many old copies of the world the game keeps." },
    { "key": "logoImage", "label": "Rust+ logo URL", "type": "string", "maxLength": 255, "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,=%-]{1,240}$",
      "description": "Logo shown in the Rust+ companion app." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 28015,
      "description": "Players connect over UDP. RCON listens on TCP on the same port and is only used by Pulsar on this machine." },
    { "name": "query", "label": "Server list query", "protocols": ["udp"], "default": 28017 },
    { "name": "app", "label": "Rust+ companion app", "protocols": ["tcp"], "default": 28082, "required": false,
      "description": "Assign it to let players pair the Rust+ app." }
  ],

  "install": { "steps": [ { "type": "steamcmd", "appId": 258550 } ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 258550 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "RustDedicated.exe",
      "arguments": [
        "-batchmode", "-nographics",
        "-logfile", "output.log",
        "+server.ip", "{{port.game.ip}}",
        "+server.port", "{{port.game}}",
        "+server.queryport", "{{port.query}}",
        "+rcon.ip", "{{port.game.ip}}",
        "+rcon.port", "{{port.game}}",
        "+rcon.password", "{{rcon.password}}",
        "+rcon.web", "0",
        { "if": "port.app", "then": ["+app.port", "{{port.app}}"], "else": ["+app.port", "-1"] },
        "+server.identity", "pulsar",
        "+server.level", "{{var.level.name}}",
        "+server.seed", "{{var.seed}}",
        "+server.worldsize", "{{var.worldSize}}",
        "+server.maxplayers", "{{var.maxPlayers}}",
        "+server.hostname", "{{var.hostname}}",
        "+server.description", "{{var.description}}",
        { "if": "var.pve", "then": ["+server.pve", "{{var.pve.value}}"] },
        { "if": "var.globalChat", "then": ["+server.globalchat", "{{var.globalChat.value}}"] },
        { "if": "var.saveInterval", "then": ["+server.saveinterval", "{{var.saveInterval}}"] },
        { "if": "var.decayScale", "then": ["+decay.scale", "{{var.decayScale}}"] },
        { "if": "var.upkeep", "then": ["+decay.upkeep", "{{var.upkeep.value}}"] },
        { "if": "var.stability", "then": ["+server.stability", "{{var.stability.value}}"] },
        { "if": "var.secure", "then": ["+server.secure", "{{var.secure.value}}"] },
        { "if": "var.instantCraft", "then": ["+craft.instant", "{{var.instantCraft.value}}"] },
        { "if": "var.airdropMinPlayers", "then": ["+server.airdropminplayers", "{{var.airdropMinPlayers}}"] },
        { "if": "var.tags", "then": ["+server.tags", "{{var.tags}}"] },
        { "if": "var.url", "then": ["+server.url", "{{var.url}}"] },
        { "if": "var.headerImage", "then": ["+server.headerimage", "{{var.headerImage}}"] },
        { "if": "var.gamemode", "then": ["+server.gamemode", "{{var.gamemode}}"] },
        { "if": "var.tickRate", "then": ["+server.tickrate", "{{var.tickRate}}"] },
        { "if": "var.salt", "then": ["+server.salt", "{{var.salt}}"] },
        { "if": "var.levelUrl", "then": ["+server.levelurl", "{{var.levelUrl}}"] },
        { "if": "var.maxTeamSize", "then": ["+relationshipmanager.maxteamsize", "{{var.maxTeamSize}}"] },
        { "if": "var.radiation", "then": ["+server.radiation", "{{var.radiation.value}}"] },
        { "if": "var.upkeepPeriod", "then": ["+decay.upkeep_period_minutes", "{{var.upkeepPeriod}}"] },
        { "if": "var.saveBackups", "then": ["+server.savebackupcount", "{{var.saveBackups}}"] },
        { "if": "var.logoImage", "then": ["+server.logoimage", "{{var.logoImage}}"] }
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "logfile+rcon",
        "logFile": "output.log",
        "rcon": { "protocol": "source", "port": "game" },
        "sensitiveCommandPrefixes": ["rcon.password", "server.password"]
      }
    }
  },

  "query": { "protocol": "a2s", "port": "query" },
  "readiness": { "type": "rcon", "timeoutSeconds": 1800 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "quit" } ],
    "timeoutSeconds": 120
  },

  "backup": {
    "include": ["server/pulsar/**", "oxide/config/**", "oxide/data/**", "oxide/plugins/**", "carbon/configs/**", "carbon/data/**", "carbon/plugins/**"],
    "exclude": ["**/*.log", "server/pulsar/*.tmp"],
    "save": { "commands": ["server.save"], "confirmation": "Saved [0-9,]+ ents, cache\\(", "timeoutSeconds": 120 }
  },

  "addons": [
    { "key": "oxide", "name": "Oxide (uMod)", "license": "MIT", "url": "https://umod.org/games/rust",
      "description": "Server plugins in C#. It replaces some of Rust's own files, so it is installed again after every game update. Plugins go in oxide/plugins.",
      "source": { "type": "githubRelease", "repo": "OxideMod/Oxide.Rust", "asset": "^Oxide\\.Rust\\.zip$" },
      "reinstallAfterUpdate": true,
      "conflicts": ["carbon"] },
    { "key": "carbon", "name": "Carbon", "license": "GPL-3.0", "url": "https://carbonmod.gg/",
      "description": "Server plugins in C#, compatible with most Oxide plugins. Installed again after every game update. Plugins go in carbon/plugins.",
      "source": { "type": "githubRelease", "repo": "CarbonCommunity/Carbon", "asset": "^Carbon\\.Windows\\.Release\\.zip$", "tag": "production_build" },
      "reinstallAfterUpdate": true,
      "conflicts": ["oxide"] }
  ],
  "commands": { "broadcast": "say \"{{message}}\"" }
}
