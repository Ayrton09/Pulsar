      "description": "The map and game mode the server starts with." },
    { "key": "lighting", "label": "Lighting", "type": "enum", "default": "Day", "options": [ { "value": "Day", "label": "Day" }, { "value": "Night", "label": "Night" } ] },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 16, "min": 1, "max": 32 },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "friendlyFire", "label": "Friendly fire", "type": "enum", "options": [ { "value": "True", "label": "On" }, { "value": "False", "label": "Off" } ] },
    { "key": "friendlyFireScale", "label": "Friendly fire damage", "type": "number", "min": 0, "max": 1,
      "description": "Share of the damage a teammate takes. 0.2 is the game's own." },
    { "key": "deadChat", "label": "Dead players talk to the living", "type": "enum", "options": [ { "value": "True", "label": "Yes" }, { "value": "False", "label": "No" } ] },
    { "key": "autoBalance", "label": "Team auto balance", "type": "enum", "options": [ { "value": "True", "label": "On" }, { "value": "False", "label": "Off" } ] },
    { "key": "mapVoting", "label": "Map voting", "type": "enum", "options": [ { "value": "True", "label": "On" }, { "value": "False", "label": "Off" } ],
      "description": "Players vote for the next map at the end of a match." },
    { "key": "minEnemies", "label": "Fewest enemies (co-op)", "type": "integer", "min": 1, "max": 60 },
    { "key": "maxEnemies", "label": "Most enemies (co-op)", "type": "integer", "min": 1, "max": 60 },
    { "key": "friendlyBots", "label": "Friendly bots (co-op)", "type": "integer", "min": 0, "max": 16 },
    { "key": "gslt", "label": "Game Server Login Token", "type": "string", "secret": true, "pattern": "^[A-Fa-f0-9]{32}$",
      "description": "Lists the server in the game's browser. Make one for app 581320 at steamcommunity.com/dev/managegameservers." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 27102, "description": "Players connect here." },
    { "name": "query", "label": "Steam query", "protocols": ["udp"], "default": 27131, "description": "The server list asks here." },
    { "name": "rcon", "label": "RCON", "protocols": ["tcp"], "default": 27140, "internal": true,
      "description": "Only Pulsar uses it, on this machine: console commands and a clean stop." }
  ],

  "install": { "steps": [
    { "type": "steamcmd", "appId": 581330 },
    { "type": "ensureDirectory", "path": "Insurgency/Saved/Config/WindowsServer" }
  ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 581330 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "Insurgency/Binaries/Win64/InsurgencyServer-Win64-Shipping.exe",
      "arguments": [
        { "if": "var.password",
          "then": ["{{var.scenario.level}}?Scenario={{var.scenario}}?Lighting={{var.lighting}}?MaxPlayers={{var.maxPlayers}}?Password={{var.password}}"],
          "else": ["{{var.scenario.level}}?Scenario={{var.scenario}}?Lighting={{var.lighting}}?MaxPlayers={{var.maxPlayers}}"] },
        "-Port={{port.game}}",
        "-QueryPort={{port.query}}",
        { "if": "var.name", "then": ["-hostname={{var.name}}"] },
        "-log",
        { "if": "var.gslt", "then": ["-GSLTToken={{var.gslt}}"] }
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "pipes",
        "encoding": "utf-8",
        "rcon": { "protocol": "source", "port": "rcon" }
      }
    }
  },

  "configFiles": [
    { "path": "Insurgency/Saved/Config/WindowsServer/Game.ini", "format": "unreal-ini", "mode": "patch",
      "section": "Rcon",
      "set": {
        "bEnabled": "True",
        "Password": "{{rcon.password}}",
        "ListenPort": "{{port.rcon}}",
        "bUseBroadcastAddress": "False",
        "ListenAddressOverride": "127.0.0.1"
      } },
    { "path": "Insurgency/Saved/Config/WindowsServer/Game.ini", "format": "unreal-ini", "mode": "patch",
      "section": "/Script/Insurgency.INSMultiplayerMode",
      "set": {
        "bAllowFriendlyFire": "{{var.friendlyFire}}",
        "FriendlyFireModifier": "{{var.friendlyFireScale}}",
        "bVoiceAllowDeadChat": "{{var.deadChat}}",
        "bAutoBalanceTeams": "{{var.autoBalance}}",
        "bMapVoting": "{{var.mapVoting}}"
      },
      "keepIfEmpty": ["bAllowFriendlyFire", "FriendlyFireModifier", "bVoiceAllowDeadChat", "bAutoBalanceTeams", "bMapVoting"] },
    { "path": "Insurgency/Saved/Config/WindowsServer/Game.ini", "format": "unreal-ini", "mode": "patch",
      "section": "/Script/Insurgency.INSCoopMode",
      "set": {
        "bAllowFriendlyFire": "{{var.friendlyFire}}",
        "FriendlyFireModifier": "{{var.friendlyFireScale}}",
        "MinimumEnemies": "{{var.minEnemies}}",
        "MaximumEnemies": "{{var.maxEnemies}}",
        "FriendlyBotQuota": "{{var.friendlyBots}}"
      },
      "keepIfEmpty": ["bAllowFriendlyFire", "FriendlyFireModifier", "MinimumEnemies", "MaximumEnemies", "FriendlyBotQuota"] }
  ],

  "query": { "protocol": "a2s", "port": "query" },
  "readiness": { "type": "query", "timeoutSeconds": 600 },

  "stop": {
    "steps": [ { "type": "rconCommand", "command": "quit" } ],
    "timeoutSeconds": 30
  },

  "backup": {
    "include": ["Insurgency/Saved/Config/**", "Insurgency/Config/Server/**"]
  },
  "commands": {
    "broadcast": "say {{message}}",
    "players": { "kick": "kick {{player}}", "ban": "permban {{player}}" }
  }
}
