{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "kf2",
  "version": "1.0.0",
  "name": "Killing Floor 2",
  "description": "Killing Floor 2 dedicated server, installed anonymously with SteamCMD. Its settings are the PCServer files of KFGame/Config, which its first start writes.",
  "authors": [
    "Pulsar contributors"
  ],
  "platforms": [
    "windows-x64"
  ],
  "requirements": {
    "minDiskGb": 30,
    "minMemoryMb": 4096
  },
  "variables": [
    {
      "key": "name",
      "label": "Server name",
      "type": "string",
      "default": "Pulsar Killing Floor 2",
      "maxLength": 64,
      "pattern": "^[^\"\\\\?]{1,64}$"
    },
    {
      "key": "map",
      "label": "Map",
      "type": "enum",
      "default": "KF-BurningParis",
      "options": [
        {
          "value": "KF-Airship",
          "label": "Airship"
        },
        {
          "value": "KF-AshwoodAsylum",
          "label": "Ashwood Asylum"
        },
        {
          "value": "KF-BarmwichTown",
          "label": "Barmwich Town"
        },
        {
          "value": "KF-Biolapse",
          "label": "Biolapse"
        },
        {
          "value": "KF-Bioticslab",
          "label": "Biotics Lab"
        },
        {
          "value": "KF-BlackForest",
          "label": "Black Forest"
        },
        {
          "value": "KF-BurningParis",
          "label": "Burning Paris"
        },
        {
          "value": "KF-CarillonHamlet",
          "label": "Carillon Hamlet"
        },
        {
          "value": "KF-CastleVolter",
          "label": "Castle Volter"
        },
        {
          "value": "KF-Catacombs",
          "label": "Catacombs"
        },
        {
          "value": "KF-ContainmentStation",
          "label": "Containment Station"
        },
        {
          "value": "KF-Crash",
          "label": "Crash"
        },
        {
          "value": "KF-Desolation",
          "label": "Desolation"
        },
        {
          "value": "KF-DieSector",
          "label": "Die Sector"
        },
        {
          "value": "KF-Elysium",
          "label": "Elysium"
        },
        {
          "value": "KF-EvacuationPoint",
          "label": "Evacuation Point"
        },
        {
          "value": "KF-Farmhouse",
          "label": "Farmhouse"
        },
        {
          "value": "KF-HellmarkStation",
          "label": "Hellmark Station"
        },
        {
          "value": "KF-HostileGrounds",
          "label": "Hostile Grounds"
        },
        {
          "value": "KF-InfernalRealm",
          "label": "Infernal Realm"
        },
        {
          "value": "KF-KrampusLair",
          "label": "Krampus Lair"
        },
        {
          "value": "KF-Lockdown",
          "label": "Lockdown"
        },
        {
          "value": "KF-MonsterBall",
          "label": "Monster Ball"
        },
        {
          "value": "KF-Moonbase",
          "label": "Moonbase"
        },
        {
          "value": "KF-Netherhold",
          "label": "Netherhold"
        },
        {
          "value": "KF-Nightmare",
          "label": "Nightmare"
        },
        {
          "value": "KF-Nuked",
          "label": "Nuked"
        },
        {
          "value": "KF-Outpost",
          "label": "Outpost"
        },
        {
          "value": "KF-Prison",
          "label": "Prison"
        },
        {
          "value": "KF-Rig",
          "label": "The Rig"
        },
        {
          "value": "KF-Sanitarium",
          "label": "Sanitarium"
        },
        {
          "value": "KF-Santasworkshop",
          "label": "Santa's Workshop"
        },
        {
          "value": "KF-ShoppingSpree",
          "label": "Shopping Spree"
        },
        {
          "value": "KF-Spillway",
          "label": "Spillway"
        },
        {
          "value": "KF-SteamFortress",
          "label": "Steam Fortress"
        },
        {
          "value": "KF-Subduction",
          "label": "Subduction"
        },
        {
          "value": "KF-TheDescent",
          "label": "The Descent"
        },
        {
          "value": "KF-TragicKingdom",
          "label": "Tragic Kingdom"
        },
        {
          "value": "KF-VolterManor",
          "label": "Volter Manor"
        },
        {
          "value": "KF-ZedLanding",
          "label": "Zed Landing"
        }
      ],
      "description": "The map the server starts on; the map cycle follows."
    },
    {
      "key": "mode",
      "label": "Game mode",
      "type": "enum",
      "default": "survival",
      "options": [
        {
          "value": "survival",
          "label": "Survival",
          "map": {
            "class": "KFGameContent.KFGameInfo_Survival"
          }
        },
        {
          "value": "weekly",
          "label": "Weekly outbreak",
          "map": {
            "class": "KFGameContent.KFGameInfo_WeeklySurvival"
          }
        },
        {
          "value": "endless",
          "label": "Endless",
          "map": {
            "class": "KFGameContent.KFGameInfo_Endless"
          }
        },
        {
          "value": "versus",
          "label": "Versus survival",
          "map": {
            "class": "KFGameContent.KFGameInfo_VersusSurvival"
          }
        }
      ]
    },
    {
      "key": "difficulty",
      "label": "Difficulty",
      "type": "enum",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "Normal"
        },
        {
          "value": "1",
          "label": "Hard"
        },
        {
          "value": "2",
          "label": "Suicidal"
        },
        {
          "value": "3",
          "label": "Hell on Earth"
        }
      ]
    },
    {
      "key": "length",
      "label": "Game length",
      "type": "enum",
      "default": "1",
      "options": [
        {
          "value": "0",
          "label": "Short (4 waves)"
        },
        {
          "value": "1",
          "label": "Medium (7 waves)"
        },
        {
          "value": "2",
          "label": "Long (10 waves)"
        }
      ]
    },
    {
      "key": "maxPlayers",
      "label": "Slots",
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 12,
      "description": "Survival takes up to 6, Versus up to 12."
    },
    {
      "key": "password",
      "label": "Join password",
      "type": "string",
      "secret": true,
      "maxLength": 32,
      "pattern": "^[^\"\\\\? ]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server."
    },
    {
      "key": "adminPassword",
      "label": "Admin password",
      "type": "string",
      "secret": true,
      "maxLength": 32,
      "pattern": "^[^\"\\\\? ]{1,32}$",
      "description": "Players who log in with it in the game (adminlogin) are its admins."
    },
    {
      "key": "motd",
      "label": "Message of the day",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\"\\\\]{1,200}$"
    },
    {
      "key": "friendlyFire",
      "label": "Friendly fire",
      "type": "number",
      "min": 0,
      "max": 1,
      "description": "Share of the damage a teammate takes. 0 is the game's own."
    },
    {
      "key": "mapVote",
      "label": "Map vote",
      "type": "enum",
      "options": [
        {
          "value": "False",
          "label": "On"
        },
        {
          "value": "True",
          "label": "Off"
        }
      ]
    },
    {
      "key": "kickVote",
      "label": "Kick vote",
      "type": "enum",
      "options": [
        {
          "value": "False",
          "label": "On"
        },
        {
          "value": "True",
          "label": "Off"
        }
      ]
    },
    {
      "key": "textChat",
      "label": "Public text chat",
      "type": "enum",
      "options": [
        {
          "value": "False",
          "label": "On"
        },
        {
          "value": "True",
          "label": "Off"
        }
      ]
    },
    {
      "key": "voice",
      "label": "Voice chat",
      "type": "enum",
      "options": [
        {
          "value": "False",
          "label": "On"
        },
        {
          "value": "True",
          "label": "Off"
        }
      ]
    }
  ],
  "ports": [
    {
      "name": "game",
      "label": "Game",
      "protocols": [
        "udp"
      ],
      "default": 7777,
      "description": "Players connect here."
    },
    {
      "name": "query",
      "label": "Steam query",
      "protocols": [
        "udp"
      ],
      "default": 27015,
      "description": "The server list asks here."
    }
  ],
  "install": {
    "steps": [
      {
        "type": "steamcmd",
        "appId": 232130
      }
    ]
  },
  "update": {
    "steps": [
      {
        "type": "steamcmd",
        "appId": 232130
      }
    ]
  },
  "runtime": {
    "windows-x64": {
      "executable": "Binaries/Win64/KFServer.exe",
      "workingDirectory": "Binaries/Win64",
      "arguments": [
        "{{var.map}}?Game={{var.mode.class}}?Difficulty={{var.difficulty}}?GameLength={{var.length}}?MaxPlayers={{var.maxPlayers}}",
        "-Port={{port.game}}",
        "-QueryPort={{port.query}}"
      ],
      "allowExtraArguments": true,
      "console": {
        "mode": "pipes",
        "encoding": "utf-8",
        "logFile": "KFGame/Logs/Launch.log"
      }
    }
  },
  "configFiles": [
    {
      "path": "KFGame/Config/PCServer-KFGame.ini",
      "format": "unreal-ini",
      "mode": "patch",
      "section": "Engine.GameReplicationInfo",
      "set": {
        "ServerName": "{{var.name}}"
      }
    },
    {
      "path": "KFGame/Config/PCServer-KFGame.ini",
      "format": "unreal-ini",
      "mode": "patch",
      "section": "Engine.AccessControl",
      "set": {
        "GamePassword": "{{var.password}}",
        "AdminPassword": "{{var.adminPassword}}"
      }
    },
    {
      "path": "KFGame/Config/PCServer-KFGame.ini",
      "format": "unreal-ini",
      "mode": "patch",
      "section": "KFGame.KFGameInfo",
      "set": {
        "ServerMOTD": "{{var.motd}}",
        "FriendlyFireScale": "{{var.friendlyFire}}",
        "bDisableMapVote": "{{var.mapVote}}",
        "bDisableKickVote": "{{var.kickVote}}",
        "bDisablePublicTextChat": "{{var.textChat}}",
        "bDisableVOIP": "{{var.voice}}"
      },
      "keepIfEmpty": [
        "ServerMOTD",
        "FriendlyFireScale",
        "bDisableMapVote",
        "bDisableKickVote",
        "bDisablePublicTextChat",
        "bDisableVOIP"
      ]
    }
  ],
  "query": {
    "protocol": "a2s",
    "port": "query"
  },
  "readiness": {
    "type": "query",
    "timeoutSeconds": 900
  },
  "stop": {
    "steps": [
      {
        "type": "ctrlC"
      }
    ],
    "timeoutSeconds": 60
  },
  "backup": {
    "include": [
      "KFGame/Config/PCServer-*.ini",
      "KFGame/Config/KFWeb.ini"
    ]
  }
}
