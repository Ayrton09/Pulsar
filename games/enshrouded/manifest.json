{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "enshrouded",
  "version": "1.1.2",
  "name": "Enshrouded",
  "description": "Enshrouded dedicated server, installed anonymously with SteamCMD. Its settings are in enshrouded_server.json and its world in the savegame folder of the server.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 8, "minMemoryMb": 8192 },

  "variables": [
    { "key": "name", "label": "Server name", "type": "string", "maxLength": 64, "pattern": "^[^\"]{1,64}$", "description": "Leave it empty to keep the name set in the game's files (or the game's own)." },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 32, "pattern": "^[^\" ]{1,32}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "slots", "label": "Slots", "type": "integer", "default": 16, "min": 1, "max": 16 },
    { "key": "preset", "label": "Difficulty", "type": "enum",
      "options": [
        { "value": "Default", "label": "Default" },
        { "value": "Relaxed", "label": "Relaxed" },
        { "value": "Hard", "label": "Hard" },
        { "value": "Survival", "label": "Survival" },
        { "value": "Custom", "label": "Custom (the options below)" }
      ],
      "description": "The options below only apply with Custom." },
    { "key": "voiceChat", "label": "Voice chat", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "textChat", "label": "Text chat", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "playerHealth", "label": "Player health", "type": "number", "min": 0.25, "max": 4 },
    { "key": "playerStamina", "label": "Player stamina", "type": "number", "min": 0.25, "max": 4 },
    { "key": "enemyDamage", "label": "Enemy damage", "type": "number", "min": 0.25, "max": 5 },
    { "key": "enemyHealth", "label": "Enemy health", "type": "number", "min": 0.25, "max": 4 },
    { "key": "miningDamage", "label": "Mining damage", "type": "number", "min": 0.5, "max": 2 },
    { "key": "resourceDrops", "label": "Resources dropped", "type": "number", "min": 0.25, "max": 2 },
    { "key": "combatXp", "label": "Combat XP", "type": "number", "min": 0, "max": 2 },
    { "key": "durability", "label": "Item durability", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "starving", "label": "Starving debuff", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "pacifyEnemies", "label": "Pacify all enemies", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Enemies never attack first." },
    { "key": "voiceChatMode", "label": "Voice chat range", "type": "enum", "options": [ { "value": "Proximity", "label": "Nearby players" }, { "value": "Global", "label": "Everyone" } ],
      "description": "Needs voice chat on." },
    { "key": "playerMana", "label": "Player mana", "type": "number", "min": 0.25, "max": 4,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "playerBodyHeat", "label": "Player body heat", "type": "enum", "options": [ { "value": "0.5", "label": "Low" }, { "value": "1.0", "label": "Default" }, { "value": "1.5", "label": "High" }, { "value": "2.0", "label": "Maximum" } ],
      "description": "How long players last in very cold areas. Only with the Custom difficulty." },
    { "key": "divingTime", "label": "Diving time", "type": "number", "min": 0.25, "max": 2,
      "description": "Oxygen players start with underwater. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "foodBuffDuration", "label": "Food buff duration", "type": "number", "min": 0.5, "max": 2,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "shroudTime", "label": "Time in the Shroud", "type": "number", "min": 0.5, "max": 2,
      "description": "How long players can stay in the Shroud. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "tombstone", "label": "On death", "type": "enum", "options": [ { "value": "AddBackpackMaterials", "label": "Lose backpack materials" }, { "value": "Everything", "label": "Lose everything" }, { "value": "NoTombstone", "label": "Keep everything" } ],
      "description": "What players lose when they die. Only with the Custom difficulty." },
    { "key": "gliderTurbulences", "label": "Glider turbulences", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Air turbulences affect the glider. Only with the Custom difficulty." },
    { "key": "weather", "label": "Weather frequency", "type": "enum", "options": [ { "value": "Disabled", "label": "None" }, { "value": "Rare", "label": "Rare" }, { "value": "Normal", "label": "Normal" }, { "value": "Often", "label": "Often" } ],
      "description": "Only with the Custom difficulty." },
    { "key": "fishingDifficulty", "label": "Fishing difficulty", "type": "enum", "options": [ { "value": "VeryEasy", "label": "Very easy" }, { "value": "Easy", "label": "Easy" }, { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Hard" }, { "value": "VeryHard", "label": "Very hard" } ],
      "description": "Only with the Custom difficulty." },
    { "key": "plantGrowth", "label": "Plant growth speed", "type": "number", "min": 0.25, "max": 2,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "workstationSpeed", "label": "Workstation speed", "type": "number", "min": 0.25, "max": 2,
      "description": "Scales the production times of workshop items; higher takes longer. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "perkCost", "label": "Weapon upgrade cost", "type": "number", "min": 0.25, "max": 2,
      "description": "Runes needed to upgrade weapons. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "recyclingYield", "label": "Rune return on salvage", "type": "number", "min": 0, "max": 1,
      "description": "Share of the Runes returned when salvaging upgraded weapons. 0.5 is the game's own. Only with the Custom difficulty." },
    { "key": "miningXp", "label": "Mining XP", "type": "number", "min": 0, "max": 2,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "explorationXp", "label": "Exploration XP", "type": "number", "min": 0.25, "max": 2,
      "description": "XP from exploring and finishing quests. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "enemyAmount", "label": "Enemy amount", "type": "enum", "options": [ { "value": "Few", "label": "Few" }, { "value": "Normal", "label": "Normal" }, { "value": "Many", "label": "Many" }, { "value": "Extreme", "label": "Extreme" } ],
      "description": "How many enemies there are in the world. Only with the Custom difficulty." },
    { "key": "simultaneousAttacks", "label": "Simultaneous attackers", "type": "enum", "options": [ { "value": "Few", "label": "Few" }, { "value": "Normal", "label": "Normal" }, { "value": "Many", "label": "Many" }, { "value": "Extreme", "label": "Extreme" } ],
      "description": "How many enemies may attack at the same time. Only with the Custom difficulty." },
    { "key": "enemyStamina", "label": "Enemy stamina", "type": "number", "min": 0.5, "max": 2,
      "description": "Higher makes enemies harder to stun. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "enemyPerception", "label": "Enemy perception", "type": "number", "min": 0.5, "max": 2,
      "description": "How far enemies see and hear players, bosses excluded. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "enemyAttackFrequency", "label": "Enemy attack frequency", "type": "number", "min": 0.25, "max": 4,
      "description": "How often enemies attack, bosses excluded. 1 is the game's own. Only with the Custom difficulty." },
    { "key": "bossHealth", "label": "Boss health", "type": "number", "min": 0.2, "max": 5,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "bossDamage", "label": "Boss damage", "type": "number", "min": 0.2, "max": 5,
      "description": "1 is the game's own. Only with the Custom difficulty." },
    { "key": "tamingFailure", "label": "Startling wildlife while taming", "type": "enum", "options": [ { "value": "KeepProgress", "label": "Keep all progress" }, { "value": "LoseSomeProgress", "label": "Lose some progress" }, { "value": "LoseAllProgress", "label": "Lose all progress" } ],
      "description": "Only with the Custom difficulty." },
    { "key": "curse", "label": "Shroud curse", "type": "enum", "options": [ { "value": "Easy", "label": "Off" }, { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Double chance" } ],
      "description": "Chance of getting the curse when attacked in the Shroud. Only with the Custom difficulty." },
    { "key": "dayLength", "label": "Daytime length", "type": "enum", "options": [ { "value": "120000000000", "label": "2 minutes" }, { "value": "600000000000", "label": "10 minutes" }, { "value": "1200000000000", "label": "20 minutes" }, { "value": "1800000000000", "label": "30 minutes (default)" }, { "value": "2700000000000", "label": "45 minutes" }, { "value": "3600000000000", "label": "60 minutes" } ],
      "description": "Real time the day lasts. Only with the Custom difficulty." },
    { "key": "nightLength", "label": "Nighttime length", "type": "enum", "options": [ { "value": "120000000000", "label": "2 minutes" }, { "value": "300000000000", "label": "5 minutes" }, { "value": "720000000000", "label": "12 minutes (default)" }, { "value": "1200000000000", "label": "20 minutes" }, { "value": "1800000000000", "label": "30 minutes" }, { "value": "3600000000000", "label": "60 minutes" } ],
      "description": "Real time the night lasts. Only with the Custom difficulty." },
    { "key": "hungerToStarving", "label": "Hungry state length", "type": "enum", "options": [ { "value": "300000000000", "label": "5 minutes" }, { "value": "600000000000", "label": "10 minutes (default)" }, { "value": "900000000000", "label": "15 minutes" }, { "value": "1200000000000", "label": "20 minutes" } ],
      "description": "How long players stay hungry before they starve. Only with the Custom difficulty." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 15637, "description": "Players connect here; the server list asks here too." }
  ],

  "install": { "steps": [
    { "type": "steamcmd", "appId": 2278520 },
    { "type": "writeFileIfMissing", "path": "enshrouded_server.json",
      "content": "{\n\t\"name\": \"Enshrouded Server\",\n\t\"saveDirectory\": \"./savegame\",\n\t\"logDirectory\": \"./logs\",\n\t\"userGroups\": [\n\t\t{\n\t\t\t\"name\": \"Default\",\n\t\t\t\"password\": \"\",\n\t\t\t\"canKickBan\": false,\n\t\t\t\"canAccessInventories\": true,\n\t\t\t\"canEditWorld\": true,\n\t\t\t\"canEditBase\": true,\n\t\t\t\"canExtendBase\": true,\n\t\t\t\"reservedSlots\": 0\n\t\t}\n\t]\n}\n" }
  ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 2278520 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "enshrouded_server.exe",
      "arguments": [],
      "allowExtraArguments": true,
      "console": { "mode": "pty", "encoding": "utf-8" }
    }
  },

  "configFiles": [
    { "path": "enshrouded_server.json", "format": "json", "mode": "patch",
      "set": {
        "/name": "{{var.name}}",
        "/userGroups/0/password": "{{var.password}}",
        "/saveDirectory": "./savegame",
        "/logDirectory": "./logs",
        "/ip": "{{port.game.ip}}",
        "/queryPort": "{{port.game}}",
        "/slotCount": "{{var.slots}}",
        "/gameSettingsPreset": "{{var.preset}}",
        "/enableVoiceChat": "{{var.voiceChat}}",
        "/enableTextChat": "{{var.textChat}}",
        "/gameSettings/playerHealthFactor": "{{var.playerHealth}}",
        "/gameSettings/playerStaminaFactor": "{{var.playerStamina}}",
        "/gameSettings/enemyDamageFactor": "{{var.enemyDamage}}",
        "/gameSettings/enemyHealthFactor": "{{var.enemyHealth}}",
        "/gameSettings/miningDamageFactor": "{{var.miningDamage}}",
        "/gameSettings/resourceDropStackAmountFactor": "{{var.resourceDrops}}",
        "/gameSettings/experienceCombatFactor": "{{var.combatXp}}",
        "/gameSettings/enableDurability": "{{var.durability}}",
        "/gameSettings/enableStarvingDebuff": "{{var.starving}}",
        "/gameSettings/pacifyAllEnemies": "{{var.pacifyEnemies}}",
        "/voiceChatMode": "{{var.voiceChatMode}}",
        "/gameSettings/playerManaFactor": "{{var.playerMana}}",
        "/gameSettings/playerBodyHeatFactor": "{{var.playerBodyHeat}}",
        "/gameSettings/playerDivingTimeFactor": "{{var.divingTime}}",
        "/gameSettings/foodBuffDurationFactor": "{{var.foodBuffDuration}}",
        "/gameSettings/shroudTimeFactor": "{{var.shroudTime}}",
        "/gameSettings/tombstoneMode": "{{var.tombstone}}",
        "/gameSettings/enableGliderTurbulences": "{{var.gliderTurbulences}}",
        "/gameSettings/weatherFrequency": "{{var.weather}}",
        "/gameSettings/fishingDifficulty": "{{var.fishingDifficulty}}",
        "/gameSettings/plantGrowthSpeedFactor": "{{var.plantGrowth}}",
        "/gameSettings/factoryProductionSpeedFactor": "{{var.workstationSpeed}}",
        "/gameSettings/perkCostFactor": "{{var.perkCost}}",
        "/gameSettings/perkUpgradeRecyclingFactor": "{{var.recyclingYield}}",
        "/gameSettings/experienceMiningFactor": "{{var.miningXp}}",
        "/gameSettings/experienceExplorationQuestsFactor": "{{var.explorationXp}}",
        "/gameSettings/randomSpawnerAmount": "{{var.enemyAmount}}",
        "/gameSettings/aggroPoolAmount": "{{var.simultaneousAttacks}}",
        "/gameSettings/enemyStaminaFactor": "{{var.enemyStamina}}",
        "/gameSettings/enemyPerceptionRangeFactor": "{{var.enemyPerception}}",
        "/gameSettings/threatBonus": "{{var.enemyAttackFrequency}}",
        "/gameSettings/bossHealthFactor": "{{var.bossHealth}}",
        "/gameSettings/bossDamageFactor": "{{var.bossDamage}}",
        "/gameSettings/tamingStartleRepercussion": "{{var.tamingFailure}}",
        "/gameSettings/curseModifier": "{{var.curse}}",
        "/gameSettings/dayTimeDuration": "{{var.dayLength}}",
        "/gameSettings/nightTimeDuration": "{{var.nightLength}}",
        "/gameSettings/fromHungerToStarving": "{{var.hungerToStarving}}"
      },
      "writeIfEmpty": ["/userGroups/0/password"],
      "keepIfEmpty": ["/name", "/gameSettingsPreset", "/enableVoiceChat", "/enableTextChat", "/gameSettings/playerHealthFactor", "/gameSettings/playerStaminaFactor",
        "/gameSettings/enemyDamageFactor", "/gameSettings/enemyHealthFactor", "/gameSettings/miningDamageFactor", "/gameSettings/resourceDropStackAmountFactor",
        "/gameSettings/experienceCombatFactor", "/gameSettings/enableDurability", "/gameSettings/enableStarvingDebuff", "/gameSettings/pacifyAllEnemies",
        "/voiceChatMode", "/gameSettings/playerManaFactor", "/gameSettings/playerBodyHeatFactor", "/gameSettings/playerDivingTimeFactor", "/gameSettings/foodBuffDurationFactor", "/gameSettings/shroudTimeFactor", "/gameSettings/tombstoneMode", "/gameSettings/enableGliderTurbulences", "/gameSettings/weatherFrequency", "/gameSettings/fishingDifficulty", "/gameSettings/plantGrowthSpeedFactor", "/gameSettings/factoryProductionSpeedFactor", "/gameSettings/perkCostFactor", "/gameSettings/perkUpgradeRecyclingFactor", "/gameSettings/experienceMiningFactor", "/gameSettings/experienceExplorationQuestsFactor", "/gameSettings/randomSpawnerAmount", "/gameSettings/aggroPoolAmount", "/gameSettings/enemyStaminaFactor", "/gameSettings/enemyPerceptionRangeFactor", "/gameSettings/threatBonus", "/gameSettings/bossHealthFactor", "/gameSettings/bossDamageFactor", "/gameSettings/tamingStartleRepercussion", "/gameSettings/curseModifier", "/gameSettings/dayTimeDuration", "/gameSettings/nightTimeDuration", "/gameSettings/fromHungerToStarving"] }
  ],

  "query": { "protocol": "a2s", "port": "game" },
  "readiness": { "type": "logPattern", "pattern": "HostOnline", "timeoutSeconds": 600 },

  "stop": {
    "steps": [ { "type": "ctrlC" } ],
    "timeoutSeconds": 90
  },

  "backup": {
    "include": ["savegame/**", "enshrouded_server.json"]
  }
}
