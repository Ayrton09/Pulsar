{
  "$schema": "../../schemas/manifest.v1.schema.json",
  "schemaVersion": 1,
  "key": "sotf",
  "version": "1.1.0",
  "name": "Sons of the Forest",
  "description": "Sons of the Forest dedicated server, installed anonymously with SteamCMD. Its settings, saves and admin list live in the userdata folder of the server.",
  "authors": ["Pulsar contributors"],
  "platforms": ["windows-x64"],

  "requirements": { "minDiskGb": 10, "minMemoryMb": 8192 },

  "variables": [
    { "key": "name", "label": "Server name", "type": "string", "default": "Pulsar Sons of the Forest", "maxLength": 64, "pattern": "^[^\"]{1,64}$" },
    { "key": "password", "label": "Join password", "type": "string", "secret": true, "maxLength": 40, "pattern": "^[^\" ]{1,40}$",
      "description": "Players need it to join. Leave empty for a public server." },
    { "key": "maxPlayers", "label": "Slots", "type": "integer", "default": 8, "min": 1, "max": 8 },
    { "key": "saveSlot", "label": "Save slot", "type": "integer", "default": 1, "min": 1, "max": 30,
      "description": "Each slot is its own world." },
    { "key": "saveMode", "label": "At start", "type": "enum", "default": "Continue",
      "options": [ { "value": "Continue", "label": "Continue the slot's world" }, { "value": "New", "label": "Start a new world in the slot" } ] },
    { "key": "gameMode", "label": "Game mode", "type": "enum", "default": "Normal",
      "options": [
        { "value": "Normal", "label": "Normal" },
        { "value": "Hard", "label": "Hard" },
        { "value": "HardSurvival", "label": "Hard survival" },
        { "value": "Peaceful", "label": "Peaceful" },
        { "value": "Creative", "label": "Creative" },
        { "value": "Custom", "label": "Custom" }
      ],
      "description": "Applies to a new world. The custom game mode options below apply only with Custom." },
    { "key": "saveInterval", "label": "Autosave every (s)", "type": "integer", "min": 60, "max": 3600 },
    { "key": "lanOnly", "label": "LAN only", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "treeRegrowth", "label": "Trees grow back", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ] },
    { "key": "structureDamage", "label": "Structure damage", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Enemies and players can break buildings." },
    { "key": "enemySpawn", "label": "Enemies spawn", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "enemyHealth", "label": "Enemy health", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Normal", "label": "Normal" }, { "value": "High", "label": "High" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "enemyDamage", "label": "Enemy damage", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Normal", "label": "Normal" }, { "value": "High", "label": "High" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "enemyArmour", "label": "Enemy armour", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Normal", "label": "Normal" }, { "value": "High", "label": "High" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "enemyAggression", "label": "Enemy aggression", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Normal", "label": "Normal" }, { "value": "High", "label": "High" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "animalSpawnRate", "label": "Animal spawn rate", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Normal", "label": "Normal" }, { "value": "High", "label": "High" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "startingSeason", "label": "Starting season", "type": "enum", "options": [ { "value": "Spring", "label": "Spring" }, { "value": "Summer", "label": "Summer" }, { "value": "Autumn", "label": "Autumn" }, { "value": "Winter", "label": "Winter" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "seasonLength", "label": "Season length", "type": "enum", "options": [ { "value": "Short", "label": "Short" }, { "value": "Default", "label": "Default" }, { "value": "Long", "label": "Long" }, { "value": "Realistic", "label": "Realistic" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "dayLength", "label": "Day length", "type": "enum", "options": [ { "value": "Short", "label": "Short" }, { "value": "Default", "label": "Default" }, { "value": "Long", "label": "Long" }, { "value": "Realistic", "label": "Realistic" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "precipitation", "label": "Rain and snow", "type": "enum", "options": [ { "value": "Low", "label": "Low" }, { "value": "Default", "label": "Default" }, { "value": "High", "label": "High" } ],
      "description": "How often it rains or snows. Only with the Custom game mode, in a new world." },
    { "key": "consumableEffects", "label": "Hunger and thirst damage", "type": "enum", "options": [ { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Hard" } ],
      "description": "Damage taken when hydration and fullness are low. Only with the Custom game mode, in a new world." },
    { "key": "playerStatsDamage", "label": "Bad food damage", "type": "enum", "options": [ { "value": "Off", "label": "Off" }, { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Hard" } ],
      "description": "Damage from bad or rotten food and drink. Only with the Custom game mode, in a new world." },
    { "key": "coldPenalties", "label": "Cold penalties", "type": "enum", "options": [ { "value": "Off", "label": "Off" }, { "value": "Normal", "label": "Normal" }, { "value": "Hard", "label": "Hard" } ],
      "description": "How much cold hurts health and stamina regeneration. Only with the Custom game mode, in a new world." },
    { "key": "reducedFood", "label": "Less food in containers", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Only with the Custom game mode, in a new world." },
    { "key": "singleUseContainers", "label": "Single-use containers", "type": "enum", "options": [ { "value": "true", "label": "On" }, { "value": "false", "label": "Off" } ],
      "description": "Containers can be opened only once. Only with the Custom game mode, in a new world." },
    { "key": "idleDayCycle", "label": "Day cycle speed when empty", "type": "number", "min": 0, "max": 10,
      "description": "How fast time passes while nobody is online: 0 stops it, 1 is normal speed." },
    { "key": "activeFps", "label": "Server frame rate", "type": "integer", "min": 10, "max": 240,
      "description": "Target frames per second with players online. Lower uses less CPU. 60 is the game's own." },
    { "key": "idleFps", "label": "Server frame rate when empty", "type": "integer", "min": 1, "max": 60,
      "description": "Target frames per second with nobody online. 5 is the game's own." }
  ],

  "ports": [
    { "name": "game", "label": "Game", "protocols": ["udp"], "default": 8766, "description": "Players connect here." },
    { "name": "query", "label": "Steam query", "protocols": ["udp"], "default": 27016, "description": "The server list asks here." },
    { "name": "blob_sync", "label": "Blob sync", "protocols": ["udp"], "default": 9700, "description": "The game syncs the world's objects here." }
  ],

  "install": { "steps": [
    { "type": "steamcmd", "appId": 2465200 },
    { "type": "ensureDirectory", "path": "userdata" },
    { "type": "writeFileIfMissing", "path": "steam_appid.txt", "content": "1326470" },
    { "type": "writeFileIfMissing", "path": "userdata/ownerswhitelist.txt",
      "content": "# The SteamID64 of each owner of the server, one per line: they administrate it from the game.\n" }
  ] },
  "update": { "steps": [ { "type": "steamcmd", "appId": 2465200 } ] },

  "runtime": {
    "windows-x64": {
      "executable": "SonsOfTheForestDS.exe",
      "arguments": ["-userdatapath", "{{server.dir}}/userdata"],
      "allowExtraArguments": true,
      "console": { "mode": "pty", "encoding": "utf-8" }
    }
  },

  "configFiles": [
    { "path": "userdata/dedicatedserver.cfg", "format": "json", "mode": "patch",
      "set": {
        "/IpAddress": "{{port.game.ip}}",
        "/GamePort": "{{port.game}}",
        "/QueryPort": "{{port.query}}",
        "/BlobSyncPort": "{{port.blob_sync}}",
        "/ServerName": "{{var.name}}",
        "/MaxPlayers": "{{var.maxPlayers}}",
        "/Password": "{{var.password}}",
        "/SaveSlot": "{{var.saveSlot}}",
        "/SaveMode": "{{var.saveMode}}",
        "/GameMode": "{{var.gameMode}}",
        "/SaveInterval": "{{var.saveInterval}}",
        "/LanOnly": "{{var.lanOnly}}",
        "/SkipNetworkAccessibilityTest": "true",
        "/GameSettings/Gameplay.TreeRegrowth": "{{var.treeRegrowth}}",
        "/GameSettings/Structure.Damage": "{{var.structureDamage}}",
        "/CustomGameModeSettings/GameSetting.Vail.EnemySpawn": "{{var.enemySpawn}}",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyHealth": "{{var.enemyHealth}}",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyDamage": "{{var.enemyDamage}}",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyArmour": "{{var.enemyArmour}}",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyAggression": "{{var.enemyAggression}}",
        "/CustomGameModeSettings/GameSetting.Vail.AnimalSpawnRate": "{{var.animalSpawnRate}}",
        "/CustomGameModeSettings/GameSetting.Environment.StartingSeason": "{{var.startingSeason}}",
        "/CustomGameModeSettings/GameSetting.Environment.SeasonLength": "{{var.seasonLength}}",
        "/CustomGameModeSettings/GameSetting.Environment.DayLength": "{{var.dayLength}}",
        "/CustomGameModeSettings/GameSetting.Environment.PrecipitationFrequency": "{{var.precipitation}}",
        "/CustomGameModeSettings/GameSetting.Survival.ConsumableEffects": "{{var.consumableEffects}}",
        "/CustomGameModeSettings/GameSetting.Survival.PlayerStatsDamage": "{{var.playerStatsDamage}}",
        "/CustomGameModeSettings/GameSetting.Survival.ColdPenalties": "{{var.coldPenalties}}",
        "/CustomGameModeSettings/GameSetting.Survival.ReducedFoodInContainers": "{{var.reducedFood}}",
        "/CustomGameModeSettings/GameSetting.Survival.SingleUseContainers": "{{var.singleUseContainers}}",
        "/IdleDayCycleSpeed": "{{var.idleDayCycle}}",
        "/ActiveTargetFramerate": "{{var.activeFps}}",
        "/IdleTargetFramerate": "{{var.idleFps}}"
      },
      "keepIfEmpty": ["/SaveInterval", "/LanOnly", "/GameSettings/Gameplay.TreeRegrowth", "/GameSettings/Structure.Damage",
        "/CustomGameModeSettings/GameSetting.Vail.EnemySpawn",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyHealth",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyDamage",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyArmour",
        "/CustomGameModeSettings/GameSetting.Vail.EnemyAggression",
        "/CustomGameModeSettings/GameSetting.Vail.AnimalSpawnRate",
        "/CustomGameModeSettings/GameSetting.Environment.StartingSeason",
        "/CustomGameModeSettings/GameSetting.Environment.SeasonLength",
        "/CustomGameModeSettings/GameSetting.Environment.DayLength",
        "/CustomGameModeSettings/GameSetting.Environment.PrecipitationFrequency",
        "/CustomGameModeSettings/GameSetting.Survival.ConsumableEffects",
        "/CustomGameModeSettings/GameSetting.Survival.PlayerStatsDamage",
        "/CustomGameModeSettings/GameSetting.Survival.ColdPenalties",
        "/CustomGameModeSettings/GameSetting.Survival.ReducedFoodInContainers",
        "/CustomGameModeSettings/GameSetting.Survival.SingleUseContainers",
        "/IdleDayCycleSpeed",
        "/ActiveTargetFramerate",
        "/IdleTargetFramerate"] }
  ],

  "query": { "protocol": "a2s", "port": "query" },
  "readiness": { "type": "logPattern", "pattern": "Dedicated server loaded.", "timeoutSeconds": 1800 },

  "stop": {
    "steps": [ { "type": "ctrlC" } ],
    "timeoutSeconds": 120
  },

  "backup": {
    "include": ["userdata/**"],
    "exclude": ["userdata/logs/**"]
  }
}
