<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version below also applies where a package comes in through another (see "Transitive"). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Domain">
    <!-- Cron occurrences with time zones and DST (MIT; ADR-0010). -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
  </ItemGroup>

  <ItemGroup Label="Notifications and remote storage">
    <!-- Email notifications over SMTP (MIT; Phase 10). -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Remote backups to S3-compatible storage, used by the agent (Apache-2.0; Phase 10). -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.6" />
    <!-- Game databases: the panel creates MySQL/MariaDB databases and users (MIT; Phase 13). -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Web API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="SFTP">
    <!-- The panel's SFTP server: SSH2 transport and authentication over our own listener; the SFTP v3 handler is Pulsar's own (MIT, no dependencies; Phase 17, spike 0003). -->
    <PackageVersion Include="Microsoft.DevTunnels.Ssh" Version="3.12.42" />
    <!-- SSH public keys: Ed25519 (which neither .NET nor the SSH library has) and the curve checks of pasted keys (MIT; Phase 17). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence and identity">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Windows interop">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
  </ItemGroup>

  <ItemGroup Label="Transitive">
    <!-- MailKit (MimeKit) asks for 10.0.0, which has denial-of-service advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- JSON Schema validation of the published manifest schema (BSD-3-Clause; JsonSchema.Net moved to a commercial EULA). -->
    <PackageVersion Include="LateApexEarlySpeed.Json.Schema" Version="4.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- SSH and SFTP client that drives the panel's SFTP server in the tests (MIT; Phase 17). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
